      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 8px; margin-top: 10px;
    }
    .stat {
      background: var(--surface-alt); border-radius: 4px;
      padding: 8px 10px;
    }
    .stat .label { font-size: 11px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.5px; }
    .stat .val { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .stat .val.dim { color: var(--text-dim); font-weight: 500; font-size: 14px; }
    .row { display: flex; gap: 14px; flex-wrap: wrap; }
    .row > * { flex: 1; min-width: 240px; }
    svg { display: block; max-width: 100%; height: auto; }
    .axis { stroke: var(--border); stroke-width: 1; fill: none; }
    .axis-label { fill: var(--text-dim); font-size: 10px; font-family: inherit; }
    .grid-line { stroke: var(--surface-alt); stroke-width: 1; }
