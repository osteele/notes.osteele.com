  blockquote.agent {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.62;
    border-radius: 16px;
    padding: 0.78rem 1.05rem;
    margin: 1.15rem 0;
    color: var(--primary-color);
  }
  .prompt .who,
  blockquote.agent .who {
    display: flex;
    align-items: center;
