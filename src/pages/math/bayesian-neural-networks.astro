      }
      let dragState = null;
      function hitIndex(arr, pt, radius) {
        let best = -1, bd = radius;
        for (let i = 0; i < arr.length; i++) {
          const d = Math.hypot(arr[i].x - pt.x, arr[i].y - pt.y);
          if (d < bd) { bd = d; best = i; }
        }
        return best;
      }
      function bindDataCanvas(id) {
        const c = $(id);
        c.style.cursor = "crosshair";
        c.addEventListener("mousedown", (event) => {
          const pt = rightPanelHit(c, event); if (!pt) return;
          const idx = hitIndex(data, pt, 0.22);
          if (event.altKey) {
            if (idx >= 0 && data.length > 1) { data.splice(idx, 1); evResetHistory(); recomputePosterior(); }
            return;
          }
          if (idx >= 0) { dragState = { canvas: id, idx, kind: "data" }; c.style.cursor = "grabbing"; }
          else { data.push(pt); evResetHistory(); recomputePosterior(); }
        });
        c.addEventListener("mousemove", (event) => {
          if (!dragState || dragState.kind !== "data") {
            const pt = rightPanelHit(c, event);
            c.style.cursor = pt && hitIndex(data, pt, 0.22) >= 0 ? "grab" : "crosshair";
            return;
          }
          const pt = rightPanelHit(c, event); if (!pt) return;
          data[dragState.idx] = pt; evResetHistory(); recomputePosterior();
        });
        const release = () => { if (dragState && dragState.kind === "data") { $(dragState.canvas).style.cursor = "crosshair"; dragState = null; } };
        c.addEventListener("mouseup", release);
        c.addEventListener("mouseleave", release);
      }
      bindDataCanvas("bnn-posterior");
      bindDataCanvas("bnn-laplace");
      // Figure 2 left panel: drag the weight probe anywhere in weight space.
      function bindProbe() {
        const c = $("bnn-laplace");
        if (!c) return;
        function leftHit(event) {
          const r = c.getBoundingClientRect();
          const mx = event.clientX - r.left, my = event.clientY - r.top;
          const leftW = r.width * 0.5;
          const lpx = 42, lpy = 32, lpw = leftW - 76, lph = r.height - 72;
          if (mx < lpx || mx > lpx + lpw || my < lpy || my > lpy + lph) return null;
          return { w1: (mx - lpx) / lpw * 2 * W - W, w2: (1 - (my - lpy) / lph) * 2 * W - W };
        }
        c.addEventListener("mousedown", (event) => {
          const pt = leftHit(event); if (!pt) return;
          dragState = { canvas: "bnn-laplace", kind: "probe" };
          probe = pt; c.style.cursor = "grabbing"; drawLaplace();
        });
        c.addEventListener("mousemove", (event) => {
          if (!dragState || dragState.kind !== "probe") {
            if (leftHit(event)) c.style.cursor = "crosshair";
            return;
          }
          const pt = leftHit(event); if (!pt) return;
          probe = pt; c.style.cursor = "grabbing"; drawLaplace();
        });
        const rel = () => { if (dragState && dragState.kind === "probe") { dragState = null; c.style.cursor = "crosshair"; } };
        c.addEventListener("mouseup", rel);
        c.addEventListener("mouseleave", rel);
      }
      bindProbe();
      // ---- Figure 4: drag pinned data points ------------------------------------------------
      function priorPanelHit(event) {
        // Either panel — data points appear in both; editing affects the posterior band.
        const c = $("bnn-prior");
        const r = c.getBoundingClientRect();
        const cssW = r.width, cssH = r.height;
        const px = event.clientX - r.left, py = event.clientY - r.top;
        const halfH = (cssH - 60) / 2;
        const gx = 48, gw = cssW - 80;
        if (px < gx || px > gx + gw) return null;
        // Try top panel first, then bottom
        for (const yTop of [28, 28 + halfH + 18]) {
          const gy = yTop, gh = halfH;
          if (py >= gy && py <= gy + gh) {
            return { x: (px - gx) / gw * 4.4 - 2.2, y: (1 - (py - gy) / gh) * 4.8 - 2.4 };
          }
        }
        return null;
      }
      const priorCanvas = $("bnn-prior");
      priorCanvas.style.cursor = "crosshair";
      priorCanvas.addEventListener("mousedown", (event) => {
        const pt = priorPanelHit(event); if (!pt) return;
        const idx = hitIndex(priorData, pt, 0.22);
        if (event.altKey) {
          if (idx >= 0 && priorData.length > 1) { priorData.splice(idx, 1); drawPrior(); }
          return;
        }
        if (idx >= 0) { dragState = { canvas: "bnn-prior", idx, kind: "prior" }; priorCanvas.style.cursor = "grabbing"; }
        else { priorData.push(pt); drawPrior(); }
      });
      priorCanvas.addEventListener("mousemove", (event) => {
        if (!dragState || dragState.kind !== "prior") {
          const pt = priorPanelHit(event);
          priorCanvas.style.cursor = pt && hitIndex(priorData, pt, 0.22) >= 0 ? "grab" : "crosshair";
          return;
        }
        const pt = priorPanelHit(event); if (!pt) return;
        priorData[dragState.idx] = pt; drawPrior();
      });
      const priorRelease = () => { if (dragState && dragState.kind === "prior") { priorCanvas.style.cursor = "crosshair"; dragState = null; } };
      priorCanvas.addEventListener("mouseup", priorRelease);
      priorCanvas.addEventListener("mouseleave", priorRelease);
      function setView(v) {
        posteriorView = v;
        ["M", "ed", "ew"].forEach((k) => $("bnn-view-" + k).classList.toggle("active", k === v));
        drawPosterior();
      }
      $("bnn-view-M").addEventListener("click", () => setView("M"));
      $("bnn-view-ed").addEventListener("click", () => setView("ed"));
      $("bnn-view-ew").addEventListener("click", () => setView("ew"));
      function setVarianceView(v) {
        varianceView = v;
        ["param", "noise", "total"].forEach((k) => $("bnn-var-" + k).classList.toggle("active", k === v));
        drawLaplace();
      }
      $("bnn-var-param").addEventListener("click", () => setVarianceView("param"));
      $("bnn-var-noise").addEventListener("click", () => setVarianceView("noise"));
      $("bnn-var-total").addEventListener("click", () => setVarianceView("total"));
      function setViView(v) {
        viView = v;
        const map3 = { off: "bnn-vi-off", reverse: "bnn-vi-rev", forward: "bnn-vi-fwd" };
        Object.entries(map3).forEach(([k, id]) => $(id).classList.toggle("active", k === v));
        drawLaplace();
      }
      $("bnn-vi-off").addEventListener("click", () => setViView("off"));
      $("bnn-vi-rev").addEventListener("click", () => setViView("reverse"));
      $("bnn-vi-fwd").addEventListener("click", () => setViView("forward"));
      $("bnn-ev-reset").addEventListener("click", () => evResetWith(0.05, 0.5));
      $("bnn-ev-reset-tight").addEventListener("click", () => evResetWith(10, 15));
      $("bnn-ev-step").addEventListener("click", evStep);
      $("bnn-ev-run").addEventListener("click", evRun);
      $("bnn-ev-apply").addEventListener("click", evApply);
      ["bnn-alpha", "bnn-beta"].forEach((id) => $(id).addEventListener("input", recomputePosterior));
      $("bnn-new-data").addEventListener("click", () => makeData(dataMode));
      $("bnn-data-asym").addEventListener("click", () => makeData("asym"));
      $("bnn-data-sym").addEventListener("click", () => makeData("sym"));
      $("bnn-data-sparse").addEventListener("click", () => makeData("sparse"));
      ["bnn-a1", "bnn-a2"].forEach((id) => $(id).addEventListener("input", drawPrior));
      $("bnn-prior-balanced").addEventListener("click", () => { $("bnn-a1").value = "0.6"; $("bnn-a2").value = "0.6"; drawPrior(); });
      $("bnn-prior-tight-in").addEventListener("click", () => { $("bnn-a1").value = "0.6"; $("bnn-a2").value = "10"; drawPrior(); });
      $("bnn-prior-tight-out").addEventListener("click", () => { $("bnn-a1").value = "10"; $("bnn-a2").value = "0.6"; drawPrior(); });
      makeData("asym"); window.addEventListener("resize", drawAll);
    })();
  </script>
</ExplainerLayout>
