---
import { Code } from "astro:components";

interface Step {
  description: string;
  code: string;
}

interface Props {
  steps: Step[];
  canvasHeight?: number;
  animated?: boolean;
}

const { steps, canvasHeight = 400, animated = false } = Astro.props;

// Re-indent code based on brace nesting, since MDX strips leading whitespace
function reindent(source: string, indent = "  "): string {
  const lines = source.trim().split("\n");
  let depth = 0;
  return lines.map((line) => {
    const trimmed = line.trim();
    if (trimmed.startsWith("}") || trimmed.startsWith("]") || trimmed.startsWith(")")) {
      depth = Math.max(0, depth - 1);
    }
    const result = trimmed.length > 0 ? indent.repeat(depth) + trimmed : "";
    if (trimmed.endsWith("{") || trimmed.endsWith("[") || trimmed.endsWith("(")) {
      depth++;
    }
    return result;
  }).join("\n");
}

const containerId = `step-tutorial-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="step-tutorial" id={containerId} data-canvas-height={canvasHeight} data-animated={animated ? "true" : undefined}>
  <div class="step-tutorial-left">
    {steps.map((step, i) => (
      <div class="step-panel" data-step={i} style={i === 0 ? "" : "display:none"}>
        <div class="step-description" set:html={step.description} />
        <div class="step-code" data-raw-code={step.code}>
          <Code code={reindent(step.code)} lang="javascript" theme="github-light" />
        </div>
      </div>
    ))}
  </div>
  <div class="step-tutorial-right">
    <div class="step-canvas-wrapper">
      <div class="p5-canvas"></div>
      <button class="p5-reset" aria-label="Reset values" style="display:none">↺</button>
      {animated && <button class="p5-play-pause" aria-label="Pause">⏸</button>}
    </div>
  </div>
  <div class="step-tutorial-nav">
    <button class="step-btn" data-action="rewind" aria-label="First step">⏮</button>
    <button class="step-btn" data-action="prev" aria-label="Previous step">◀</button>
    <span class="step-indicator">Step 1 of {steps.length}</span>
    <button class="step-btn" data-action="next" aria-label="Next step">▶</button>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/p5@1/lib/p5.min.js"></script>
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.step-tutorial').forEach(function(tutorial) {
    if (tutorial.dataset.stInit) return;
    tutorial.dataset.stInit = 'true';

    var canvasEl = tutorial.querySelector('.p5-canvas');
    var CANVAS_HEIGHT = parseInt(tutorial.dataset.canvasHeight) || 400;
    var CANVAS_WIDTH = canvasEl.offsetWidth || 300;
    var isAnimated = tutorial.dataset.animated === 'true';
    var noLoopCall = isAnimated ? '' : ' p.noLoop();';
    var p5Instance = null;
    var currentStep = 0;
    var panels = tutorial.querySelectorAll('.step-panel');
    var totalSteps = panels.length;
    var indicator = tutorial.querySelector('.step-indicator');
    var resetBtn = tutorial.querySelector('.p5-reset');

    var MAX_LOOP_ITERATIONS = 10000;

    function addLoopGuards(code) {
      var id = 0;
      return code.replace(/(for\s*\([^)]*\)\s*\{|while\s*\([^)]*\)\s*\{)/g, function(match) {
        var name = '__lc' + (id++);
        return 'var ' + name + '=0; ' + match + ' if(++' + name + '>' + MAX_LOOP_ITERATIONS + ') break;';
      });
    }

    function runSketch(code) {
      if (p5Instance) { p5Instance.remove(); }
      p5Instance = new p5(function(p) {
        var modified = addLoopGuards(code)
          .replace(/windowWidth/g, String(CANVAS_WIDTH))
          .replace(/windowHeight/g, String(CANVAS_HEIGHT));
        var fn = new Function('p', 'with (p) {\n' +
          modified + '\n' +
          'if (typeof setup === "function") {\n' +
          '  p.setup = function() { setup();' + noLoopCall + ' };\n' +
          '} else {\n' +
          '  p.setup = function() { createCanvas(' + CANVAS_WIDTH + ', ' + CANVAS_HEIGHT + '); background(220);' + noLoopCall + ' };\n' +
          '}\n' +
          'if (typeof draw === "function") {\n' +
          '  p.draw = draw;\n' +
          '}\n' +
          '}');
        fn(p);
      }, canvasEl);
      return p5Instance;
    }

    // Scrubbable numbers state for current step
    var scrubState = null;

    function initScrubbable() {
      var panel = panels[currentStep];
      var codeStr = panel.querySelector('.step-code').dataset.rawCode;
      var codeBlock = panel.querySelector('pre code');
      if (!codeStr || !codeBlock) { scrubState = null; return; }

      var numRegex = /-?\d+(\.\d+)?/g;
      var positions = [];
      var match;
      while ((match = numRegex.exec(codeStr)) !== null) {
        positions.push({ start: match.index, end: match.index + match[0].length, original: match[0], current: match[0] });
      }

      var spans = codeBlock.querySelectorAll('span');
      var numberSpans = [];
      for (var i = 0; i < spans.length; i++) {
        var span = spans[i];
        if (span.style.color === 'rgb(0, 92, 197)' || span.style.color === '#005CC5') {
          var text = span.textContent.trim();
          if (/^-?\d+(\.\d+)?$/.test(text)) {
            numberSpans.push(span);
          }
        }
      }

      var posIndex = 0;
      var mappings = [];
      for (var j = 0; j < numberSpans.length; j++) {
        var spanText = numberSpans[j].textContent.trim();
        while (posIndex < positions.length) {
          if (positions[posIndex].original === spanText) {
            var raw = numberSpans[j].textContent;
            var prefix = raw.substring(0, raw.length - raw.trimStart().length);
            mappings.push({ span: numberSpans[j], posIdx: posIndex, prefix: prefix });
            numberSpans[j].classList.add('scrubbable-number');
            numberSpans[j].dataset.original = spanText;
            posIndex++;
            break;
          }
          posIndex++;
        }
      }

      for (var m = 0; m < mappings.length; m++) {
        mappings[m].span.addEventListener('mousedown', onMouseDown);
      }

      scrubState = { codeStr: codeStr, positions: positions, mappings: mappings };
      if (resetBtn) resetBtn.style.display = 'none';
    }

    function rebuildAndRun() {
      if (!scrubState) return;
      var modified = scrubState.codeStr;
      for (var k = scrubState.positions.length - 1; k >= 0; k--) {
        modified = modified.substring(0, scrubState.positions[k].start) + scrubState.positions[k].current + modified.substring(scrubState.positions[k].end);
      }
      runSketch(modified);
      var anyChanged = false;
      for (var k = 0; k < scrubState.mappings.length; k++) {
        if (scrubState.positions[scrubState.mappings[k].posIdx].current !== scrubState.positions[scrubState.mappings[k].posIdx].original) {
          anyChanged = true;
          break;
        }
      }
      if (resetBtn) resetBtn.style.display = anyChanged ? '' : 'none';
    }

    var dragging = null;

    function onMouseDown(e) {
      if (!scrubState) return;
      e.preventDefault();
      var span = e.currentTarget;
      var mapping = null;
      for (var k = 0; k < scrubState.mappings.length; k++) {
        if (scrubState.mappings[k].span === span) { mapping = scrubState.mappings[k]; break; }
      }
      if (!mapping) return;
      var pos = scrubState.positions[mapping.posIdx];
      var isFloat = pos.original.indexOf('.') !== -1;
      dragging = { span: span, mapping: mapping, startX: e.clientX, startVal: parseFloat(pos.current), isFloat: isFloat };
      document.body.style.cursor = 'ew-resize';
      document.body.style.userSelect = 'none';
    }

    document.addEventListener('mousemove', function(e) {
      if (!dragging) return;
      var delta = e.clientX - dragging.startX;
      var newVal;
      if (dragging.isFloat) {
        newVal = dragging.startVal + delta * 0.01;
        newVal = Math.round(newVal * 100) / 100;
      } else {
        newVal = Math.round(dragging.startVal + delta);
      }
      dragging.span.textContent = dragging.mapping.prefix + String(newVal);
      scrubState.positions[dragging.mapping.posIdx].current = String(newVal);
      rebuildAndRun();
    });

    document.addEventListener('mouseup', function() {
      if (!dragging) return;
      dragging = null;
      document.body.style.cursor = '';
      document.body.style.userSelect = '';
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        if (!scrubState) return;
        for (var k = 0; k < scrubState.mappings.length; k++) {
          var pos = scrubState.positions[scrubState.mappings[k].posIdx];
          pos.current = pos.original;
          scrubState.mappings[k].span.textContent = scrubState.mappings[k].prefix + pos.original;
        }
        rebuildAndRun();
      });
    }

    // Play/pause for animated sketches
    if (isAnimated) {
      var playBtn = tutorial.querySelector('.p5-play-pause');
      if (playBtn) {
        var running = true;
        playBtn.addEventListener('click', function() {
          if (running) {
            p5Instance.noLoop();
            playBtn.textContent = '▶';
            playBtn.setAttribute('aria-label', 'Play');
          } else {
            p5Instance.loop();
            playBtn.textContent = '⏸';
            playBtn.setAttribute('aria-label', 'Pause');
          }
          running = !running;
        });
      }
    }

    function goToStep(index) {
      if (index < 0 || index >= totalSteps) return;
      currentStep = index;
      for (var i = 0; i < panels.length; i++) {
        panels[i].style.display = i === index ? '' : 'none';
      }
      indicator.textContent = 'Step ' + (index + 1) + ' of ' + totalSteps;

      // Update button states
      var prevBtn = tutorial.querySelector('[data-action="prev"]');
      var rewindBtn = tutorial.querySelector('[data-action="rewind"]');
      var nextBtn = tutorial.querySelector('[data-action="next"]');
      prevBtn.disabled = index === 0;
      rewindBtn.disabled = index === 0;
      nextBtn.disabled = index === totalSteps - 1;

      // Run sketch for this step
      var codeStr = panels[index].querySelector('.step-code').dataset.rawCode;
      runSketch(codeStr);
      initScrubbable();
    }

    // Nav buttons
    tutorial.querySelector('[data-action="rewind"]').addEventListener('click', function() { goToStep(0); });
    tutorial.querySelector('[data-action="prev"]').addEventListener('click', function() { goToStep(currentStep - 1); });
    tutorial.querySelector('[data-action="next"]').addEventListener('click', function() { goToStep(currentStep + 1); });

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'ArrowLeft') { goToStep(currentStep - 1); }
      else if (e.key === 'ArrowRight') { goToStep(currentStep + 1); }
    });

    // Initialize first step
    goToStep(0);
  });
});
</script>
