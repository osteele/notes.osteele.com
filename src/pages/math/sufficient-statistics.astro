  <div class="control">
    <label>currency</label>
    <PresetRow>
      <button class="flow-mode active" data-mode="likelihood">likelihood</button>
      <button class="flow-mode" data-mode="variance">variance</button>
      <button class="flow-mode" data-mode="info">Fisher info</button>
    </PresetRow>
  </div>
  <div class="control">
    <label>candidate $T$</label>
    <PresetRow>
      <button class="flow-suff active" data-suff="yes">sufficient (x̄)</button>
      <button class="flow-suff" data-suff="no">insufficient (x₁)</button>
    </PresetRow>
  </div>
  <ControlRange id="flow-theta" label={String.raw`$\theta$`} valueId="flow-theta-v" min="-1.5" max="1.5" step="0.05" value="0.4" />
  <ControlRange id="flow-n" label="$n$" valueId="flow-n-v" min="2" max="40" step="1" value="12" />
</Fragment>
</Figure>

<script is:inline>
(() => {
  const canvas = document.getElementById("fig-flow");
  const thetaIn = document.getElementById("flow-theta");
  const nIn = document.getElementById("flow-n");
  const thetaV = document.getElementById("flow-theta-v");
  const nV = document.getElementById("flow-n-v");
  const readout = document.getElementById("flow-readout");
  let mode = "likelihood", suff = "yes";

  document.querySelectorAll(".flow-mode").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll(".flow-mode").forEach(x => x.classList.remove("active"));
    b.classList.add("active"); mode = b.dataset.mode; draw();
  }));
  document.querySelectorAll(".flow-suff").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll(".flow-suff").forEach(x => x.classList.remove("active"));
    b.classList.add("active"); suff = b.dataset.suff; draw();
  }));

  function setup(c) {
    const ratio = window.devicePixelRatio || 1;
    const iw = +c.getAttribute("width"), ih = +c.getAttribute("height");
    c.style.width = "100%"; c.style.height = `${c.getBoundingClientRect().width * ih / iw}px`;
    const r = c.getBoundingClientRect();
    c.width = r.width * ratio; c.height = r.height * ratio;
    const ctx = c.getContext("2d"); ctx.scale(ratio, ratio);
    return { ctx, w: r.width, h: r.height };
  }

  function drawNode(ctx, x, y, r, label, sublabel, fill) {
    ctx.fillStyle = fill || "#fff";
    ctx.strokeStyle = "#1f2733"; ctx.lineWidth = 1.4;
    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.fillStyle = "#0f172a"; ctx.font = "bold 14px -apple-system, sans-serif"; ctx.textAlign = "center";
    ctx.fillText(label, x, y + 4);
    if (sublabel) {
      ctx.fillStyle = "#475569"; ctx.font = "10px -apple-system, sans-serif";
      ctx.fillText(sublabel, x, y + r + 14);
    }
  }

  function drawArrow(ctx, x1, y1, x2, y2, color, label, lw) {
    ctx.strokeStyle = color; ctx.lineWidth = lw || 2;
    const dx = x2 - x1, dy = y2 - y1, len = Math.hypot(dx, dy);
    const ux = dx / len, uy = dy / len;
    const off = 24;
    const sx = x1 + ux * off, sy = y1 + uy * off;
    const ex = x2 - ux * off, ey = y2 - uy * off;
    ctx.beginPath(); ctx.moveTo(sx, sy); ctx.lineTo(ex, ey); ctx.stroke();
    // arrowhead
    const ah = 8;
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(ex, ey);
    ctx.lineTo(ex - ux * ah - uy * ah * 0.5, ey - uy * ah + ux * ah * 0.5);
    ctx.lineTo(ex - ux * ah + uy * ah * 0.5, ey - uy * ah - ux * ah * 0.5);
    ctx.closePath(); ctx.fill();
    // label
    if (label) {
      ctx.fillStyle = color; ctx.font = "bold 11px -apple-system, sans-serif"; ctx.textAlign = "center";
      ctx.fillText(label, (sx + ex) / 2 + uy * 12, (sy + ey) / 2 - ux * 12);
    }
  }

  function drawSparkline(ctx, x, y, w, h, fn, color, lw) {
    ctx.save();
    ctx.fillStyle = "rgba(255,255,255,0.85)"; ctx.fillRect(x, y, w, h);
    ctx.strokeStyle = "#cbd5e1"; ctx.lineWidth = 0.5; ctx.strokeRect(x, y, w, h);
    ctx.strokeStyle = color; ctx.lineWidth = lw || 1.6;
    ctx.beginPath();
    const N = 80;
    let maxV = -Infinity, minV = Infinity;
    const samples = [];
    for (let i = 0; i <= N; i++) { const v = fn(i / N); samples.push(v); maxV = Math.max(maxV, v); minV = Math.min(minV, v); }
    const r = maxV - minV || 1;
    samples.forEach((v, i) => {
      const px = x + (i / N) * w;
      const py = y + h - 3 - ((v - minV) / r) * (h - 6);
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    });
    ctx.stroke();
    ctx.restore();
  }

  function drawDualSpark(ctx, x, y, w, h, fnA, fnB, colorA, colorB, labelA, labelB) {
    ctx.fillStyle = "rgba(255,255,255,0.92)"; ctx.fillRect(x, y, w, h);
    ctx.strokeStyle = "#cbd5e1"; ctx.lineWidth = 0.5; ctx.strokeRect(x, y, w, h);
    const N = 80;
    const sA = [], sB = [];
    let mx = -Infinity, mn = Infinity;
    for (let i = 0; i <= N; i++) {
      const a = fnA(i / N), b = fnB(i / N);
      sA.push(a); sB.push(b);
      mx = Math.max(mx, a, b); mn = Math.min(mn, a, b);
    }
    const r = mx - mn || 1;
    [[sA, colorA, 1.8], [sB, colorB, 1.6]].forEach(([s, c, lw], idx) => {
      ctx.strokeStyle = c; ctx.lineWidth = lw;
      if (idx === 1) ctx.setLineDash([4, 3]);
      ctx.beginPath();
      s.forEach((v, i) => {
        const px = x + (i / N) * w;
        const py = y + h - 3 - ((v - mn) / r) * (h - 6);
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      });
      ctx.stroke();
      ctx.setLineDash([]);
    });
    if (labelA) {
      ctx.fillStyle = colorA; ctx.font = "9px -apple-system, sans-serif"; ctx.textAlign = "left";
      ctx.fillText(labelA, x + 3, y + 9);
      ctx.fillStyle = colorB; ctx.fillText(labelB, x + 3, y + 20);
    }
  }

  function drawBars(ctx, x, y, w, h, values, colors, labels) {
    ctx.fillStyle = "rgba(255,255,255,0.92)"; ctx.fillRect(x, y, w, h);
    ctx.strokeStyle = "#cbd5e1"; ctx.lineWidth = 0.5; ctx.strokeRect(x, y, w, h);
    const mx = Math.max(...values) || 1;
    const k = values.length;
    const slot = (w - 8) / k;
    values.forEach((v, i) => {
      const bh = (v / mx) * (h - 18);
      const bx = x + 4 + i * slot + slot * 0.18;
      ctx.fillStyle = colors[i];
      ctx.fillRect(bx, y + h - 4 - bh, slot * 0.64, bh);
      ctx.fillStyle = "#475569"; ctx.font = "9px -apple-system, sans-serif"; ctx.textAlign = "center";
      ctx.fillText(labels[i], bx + slot * 0.32, y + h - 4 + 10);
    });
  }

  function draw() {
    const { ctx, w, h } = setup(canvas);
    const theta = +thetaIn.value, n = +nIn.value;
    thetaV.textContent = theta.toFixed(2); nV.textContent = n;
    ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, w, h);

    // node positions
    const nX = w * 0.14, nY = h * 0.18;          // θ
    const xX = w * 0.35, xY = h * 0.45;          // X
    const tX = w * 0.62, tY = h * 0.28;          // T(X)
    const lX = w * 0.86, lY = h * 0.55;          // inference target (L, est, info)
    const hX = w * 0.58, hY = h * 0.78;          // h(X) residual

    // edges
    drawArrow(ctx, nX, nY, xX, xY, "#0f172a", "generates", 1.4);
    drawArrow(ctx, xX, xY, tX, tY, "#b8412a", "T", 2.4);
    drawArrow(ctx, xX, xY, hX, hY, "#94a3b8", "h", 1.6);
    drawArrow(ctx, xX, xY, lX, lY, "#1f4a8c", "direct", 1.6);
    drawArrow(ctx, tX, tY, lX, lY, "#b8412a", "g", 2.4);

    // sparklines on edges
    const sparkW = 110, sparkH = 38;
    // X → T: distribution of T(X) under θ
    drawSparkline(ctx, (xX + tX) / 2 - sparkW / 2 + 30, (xY + tY) / 2 - sparkH - 10, sparkW, sparkH,
      (u) => {
        const t = -3 + u * 6;
        return Math.exp(-0.5 * n * (t - theta) * (t - theta));
      }, "#b8412a");

    // X → h: θ-free residual (flat under θ)
    drawSparkline(ctx, (xX + hX) / 2 - sparkW / 2 + 10, (xY + hY) / 2 + 4, sparkW, sparkH,
      (u) => {
        const t = -3 + u * 6;
        return Math.exp(-0.5 * t * t);
      }, "#94a3b8");

    // X → L (direct) and T → L:  two sparklines, one per mode
    function lik(u, fromT) {
      // likelihood as function of θ
      const t = -2 + u * 4;
      const xbar = theta + 0.08 * (suff === "yes" ? 0 : 1);
      const xbarFromT = theta;
      const m = fromT ? xbarFromT : xbar;
      // for insufficient, T = x_1 has noise that makes the implied likelihood narrower or noisier
      const sd = fromT && suff === "no" ? 1.5 : 1 / Math.sqrt(n);
      return Math.exp(-0.5 * ((t - m) / sd) * ((t - m) / sd));
    }
    function fisher(u, fromT) {
      const t = -1.5 + u * 3;
      const I_X = n;
      const I_T = suff === "yes" ? n : 1; // bad statistic captures only one sample's worth of info
      return fromT ? I_T : I_X;
    }
    function varSpark(u, key) {
      // "kept" vs "discarded" bars handled separately
      return 0;
    }

    if (mode === "likelihood") {
      drawDualSpark(ctx, (xX + lX) / 2 - sparkW / 2 + 50, (xY + lY) / 2 - sparkH - 6, sparkW, sparkH,
        (u) => lik(u, false), (u) => lik(u, true), "#1f4a8c", "#b8412a", "L from X", "L from T");
    } else if (mode === "info") {
      drawDualSpark(ctx, (xX + lX) / 2 - sparkW / 2 + 50, (xY + lY) / 2 - sparkH - 6, sparkW, sparkH,
        (u) => fisher(u, false), (u) => fisher(u, true), "#1f4a8c", "#b8412a", "I_X(θ)", "I_T(θ)");
    } else {
      // variance: bars
      const varBad = 1.0;
      const varRB = suff === "yes" ? 1.0 / n : 1.0;
      const varDiscarded = varBad - varRB;
      drawBars(ctx, (xX + lX) / 2 - sparkW / 2 + 50, (xY + lY) / 2 - sparkH - 6, sparkW, sparkH,
        [varBad, varRB, varDiscarded], ["#1f4a8c", "#b8412a", "#94a3b8"], ["raw", "via T", "lost"]);
    }

    // nodes (drawn last so they sit on top of edges)
    drawNode(ctx, nX, nY, 22, "θ", "parameter", "#f1ede2");
    drawNode(ctx, xX, xY, 26, "X", "sample", "#fff");
    drawNode(ctx, tX, tY, 26, "T(X)", suff === "yes" ? "sufficient" : "insufficient", suff === "yes" ? "#fdf2ee" : "#fff7ed");
    drawNode(ctx, hX, hY, 22, "h", "θ-free", "#f1f5f9");
    const targetLabel = mode === "likelihood" ? "L(θ)" : (mode === "variance" ? "est." : "I(θ)");
    drawNode(ctx, lX, lY, 26, targetLabel, "inference", "#fff");

    // commutativity badge
    ctx.fillStyle = suff === "yes" ? "#2d7a3e" : "#d4690a";
    ctx.font = "bold 11px -apple-system, sans-serif"; ctx.textAlign = "right";
    ctx.fillText(suff === "yes" ? "diagram commutes ✓" : "leak in T projection ✗", w - 12, h - 12);

    let msg = "";
    if (mode === "likelihood") {
      msg = suff === "yes"
        ? "Both paths from X to L(θ) give the same likelihood curve. T = x̄ preserves the full likelihood."
        : "L derived from T = x₁ alone is much wider than L from the full sample. Information was lost.";
    } else if (mode === "variance") {
      msg = suff === "yes"
        ? `Var(via T) = ${(1/n).toFixed(3)} ≈ Var(raw)/n. The discarded variance is gone for free.`
        : "Conditioning on x₁ doesn't reduce variance; there's nothing extra to integrate out.";
    } else {
      msg = suff === "yes"
        ? `I_T(θ) = I_X(θ) = ${n}. Sufficiency saturates the data-processing inequality.`
        : `I_T(θ) ≈ 1 ≪ I_X(θ) = ${n}. The data-processing inequality is strict.`;
    }
    readout.innerHTML =
      `<div class="row"><span class="lbl">currency</span><span>${mode}</span></div>` +
      `<div class="row"><span class="lbl">verdict</span><span>${msg}</span></div>`;
  }

  [thetaIn, nIn].forEach(i => i.addEventListener("input", draw));
  window.addEventListener("resize", draw);
  draw();
})();
</script>

<p>
<strong>Likelihood:</strong> the two paths $X \to L$ and $X \to T \to L$
produce the same curve. <strong>Variance:</strong> the path through $T$ keeps
only the part of the variance that depends on $\theta$; the rest is in $h$,
gone for free, Rao–Blackwell. <strong>Fisher information:</strong>
$I_T(\theta) \le I_X(\theta)$ with equality iff $T$ is sufficient. This is
the data-processing inequality, and sufficiency is the case where it's tight.
One commuting square; whether it commutes is the theorem.
</p>

