    margin: 1.6rem 0;
    background: #fdfcf7;
    border: 1px solid #e3dfd2;
    border-radius: 6px;
    padding: 1rem 1rem 0.5rem;
    box-shadow: 0 1px 2px rgba(20, 30, 40, 0.08), 0 10px 30px -16px rgba(20, 30, 40, 0.14);
