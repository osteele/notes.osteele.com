  .prompt .who::before { background: #b3452c; }
  .prompt .hl {
    background: none;
    padding: 0;
    font-weight: 600;
    box-shadow: inset 0 -0.5em 0 rgba(179, 69, 44, 0.24);
  }

  /* Fable — full-width reply on the left */
  blockquote.agent {
    max-width: 94%;
    font-size: 0.95rem;
