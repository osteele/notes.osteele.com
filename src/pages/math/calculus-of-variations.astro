  <ControlRange id="fv-c2" label="curve coefficient c2" valueId="fv-c2-v" min="-0.9" max="0.9" step="0.01" value="0.42" />
  <ControlRange id="fv-c3" label="curve coefficient c3" valueId="fv-c3-v" min="-0.6" max="0.6" step="0.01" value="-0.25" />
