      <ControlRange id="bnn-a2" label={String.raw`$\alpha_{\text{in}}$ (input-layer precision)`} valueId="bnn-a2-v" min="0.1" max="20" step="0.1" value="0.6" />
      <PresetRow>
        <button id="bnn-prior-balanced" class="active">Balanced</button>
        <button id="bnn-prior-tight-in">Tight α<sub>in</sub></button>
        <button id="bnn-prior-tight-out">Tight α<sub>out</sub></button>
      </PresetRow>
