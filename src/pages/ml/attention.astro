<script is:inline>
  (() => {
    const canvas = document.getElementById("fig-mask-types");
    const archInput = document.getElementById("mask-architecture");
    const queryInput = document.getElementById("mask-query");
    const archValue = document.getElementById("mask-architecture-v");
    const queryValue = document.getElementById("mask-query-v");
    const readout = document.getElementById("mask-types-readout");
    if (!canvas || !archInput || !queryInput) return;
    const tokens = ["The", "red", "[MASK]", "cup", "fell", "."];
    function setup() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.max(1, window.devicePixelRatio || 1);
      const w = 780, h = 360;
      const cssW = rect.width || w;
      const cssH = rect.height || h;
      canvas.width = Math.round(cssW * dpr);
      canvas.height = Math.round(cssH * dpr);
      const ctx = canvas.getContext("2d");
      ctx.setTransform((cssW / w) * dpr, 0, 0, (cssH / h) * dpr, 0, 0);
      return ctx;
    }
    function draw() {
      const ctx = setup();
      const arch = archInput.value;
      const q = Number(queryInput.value);
      const n = tokens.length;
      const cell = 34;
      const x0 = 122;
      const y0 = 86;
      ctx.clearRect(0, 0, 780, 360);
      ctx.fillStyle = "#0f172a";
      ctx.font = "700 18px system-ui";
      ctx.fillText(arch === "encoder" ? "Encoder attention sees both sides" : "Decoder attention sees only the prefix", 46, 42);
      ctx.font = "12px system-ui";
      ctx.fillStyle = "#64748b";
      for (let i = 0; i < n; i += 1) {
        ctx.fillText(tokens[i], x0 + i * cell - 8, y0 - 12);
        ctx.fillText(tokens[i], 46, y0 + i * cell + 22);
      }
      for (let row = 0; row < n; row += 1) {
        for (let col = 0; col < n; col += 1) {
          const visible = arch === "encoder" ? row !== col || tokens[row] === "[MASK]" : col <= row;
          ctx.fillStyle = visible ? "#dbeafe" : "#e2e8f0";
          if (row === q && visible) ctx.fillStyle = "#bfdbfe";
          if (row === q && col === q) ctx.fillStyle = "#ffe4e6";
          ctx.strokeStyle = "#ffffff";
          ctx.fillRect(x0 + col * cell, y0 + row * cell, cell - 2, cell - 2);
          ctx.strokeRect(x0 + col * cell, y0 + row * cell, cell - 2, cell - 2);
        }
      }
      ctx.strokeStyle = "#be123c";
      ctx.lineWidth = 3;
      ctx.strokeRect(x0 - 3, y0 + q * cell - 3, n * cell + 4, cell + 2);
      const visibleCount = arch === "encoder" ? n - (tokens[q] === "[MASK]" ? 0 : 1) : q + 1;
      ctx.fillStyle = "#111827";
      ctx.font = "700 14px system-ui";
      ctx.fillText("attention mask", 410, 122);
      ctx.fillStyle = "#475569";
      ctx.font = "13px system-ui";
      const lines = arch === "encoder"
        ? ["MLM reconstruction can use left and right context.", "The hidden token is predicted from its surroundings."]
        : ["CLM prediction can only use the prefix.", "The KV cache grows one token at a time."];
      lines.forEach((line, i) => ctx.fillText(line, 410, 152 + i * 24));
      archValue.textContent = archInput.selectedOptions[0].textContent;
      queryValue.textContent = `${q}: ${tokens[q]}`;
      readout.textContent = `${archInput.selectedOptions[0].textContent} query "${tokens[q]}" has ${visibleCount} visible key positions; the mask changes what any readout could have used.`;
    }
    archInput.addEventListener("input", draw);
    queryInput.addEventListener("input", draw);
    window.addEventListener("resize", draw);
    draw();
  })();
</script>
<script is:inline src="/ml/attention/attention.js"></script>

</ExplainerLayout>
