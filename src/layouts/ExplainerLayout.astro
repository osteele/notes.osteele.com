---
import "../styles/explainer.css";
import { descriptionForPath } from "../lib/page-index";

type Section =
  | "probability-and-statistics"
  | "information-theory"
  | "random-processes"
  | "bayesian-inference"
  | "transformer-internals"
  | "interpretability-methods"
  | "phenomena-and-circuits";

interface Props {
  title: string;
  breadcrumb: string;
  description?: string;
  section?: Section;
  enableMath?: boolean;
  showToc?: boolean;
}

const SECTION_LABELS: Record<Section, string> = {
  "probability-and-statistics": "Probability & Statistics",
  "information-theory": "Information Theory",
  "random-processes": "Random Processes",
  "bayesian-inference": "Bayesian Inference",
  "transformer-internals": "Transformer Internals",
  "interpretability-methods": "Interpretability Methods",
  "phenomena-and-circuits": "Phenomena & Circuits",
};

// Which index a section belongs to. ML sections live under /ml/; the rest under
// /math/. Drives the site-nav crumb and the breadcrumb back-link.
const ML_SECTIONS = new Set<Section>(["transformer-internals", "interpretability-methods", "phenomena-and-circuits"]);

const {
  title,
  breadcrumb,
  description,
  section = "probability-and-statistics",
  enableMath = true,
  showToc = true,
} = Astro.props;
const sectionLabel = SECTION_LABELS[section];
const isMl = ML_SECTIONS.has(section);
const indexBase = isMl ? "/ml/" : "/math/";
const indexLabel = isMl ? "ml" : "math";
const metaDescription = description ?? descriptionForPath(Astro.url.pathname);
const katexOnload = "renderMathInElement(document.body,{throwOnError:false,delimiters:[{left:'$$',right:'$$',display:true},{left:'$',right:'$',display:false},{left:'\\\\[',right:'\\\\]',display:true},{left:'\\\\(',right:'\\\\)',display:false}]});";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {metaDescription && (
      <>
        <meta name="description" content={metaDescription} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:type" content="article" />
        <meta property="og:url" content={Astro.url.href} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={metaDescription} />
      </>
    )}
    {enableMath && (
      <>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
        <script
          is:inline
          defer
          src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
          onload={katexOnload}
        ></script>
      </>
    )}
  </head>
  <body>
    <nav class="nav" aria-label="Sites">
      <a href="https://osteele.com">osteele.com</a>
      <span class="sep">/</span>
      <a href="/">notes</a>
      <span class="sep">/</span>
      <a class="current" href={indexBase}>{indexLabel}</a>
    </nav>
    <main class="explainer-shell">
      <div class="explainer-content">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={`${indexBase}#${section}`}>{sectionLabel}</a>
          <span class="sep">›</span>
          <span class="current">{breadcrumb}</span>
        </nav>
        <slot />
      </div>
      {showToc && (
        <nav class="explainer-toc" aria-label="Contents" hidden>
          <div class="explainer-toc-title">Contents</div>
          <ol></ol>
        </nav>
      )}
    </main>
    {showToc && (
      <script is:inline>
        (() => {
          const content = document.querySelector(".explainer-content");
          const toc = document.querySelector(".explainer-toc");
          const list = toc?.querySelector("ol");
          if (!content || !toc || !list) return;

          const headings = Array.from(content.querySelectorAll("h2"));
          if (headings.length < 2) return;

          const usedIds = new Set(Array.from(document.querySelectorAll("[id]"), (node) => node.id));
          const slugify = (text) => {
            const base = text
              .toLowerCase()
              .normalize("NFKD")
              .replace(/[\u0300-\u036f]/g, "")
              .replace(/&/g, " and ")
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-|-$/g, "");
            return base || "section";
          };
          const uniqueId = (base) => {
            let id = base;
            let index = 2;
            while (usedIds.has(id)) {
              id = `${base}-${index}`;
              index += 1;
            }
            usedIds.add(id);
            return id;
          };

          const linksById = new Map();
          headings.forEach((heading) => {
            if (!heading.id) heading.id = uniqueId(slugify(heading.textContent || ""));

            const label = (heading.textContent || "").replace(/^\s*\d+\.\s*/, "").trim();
            const item = document.createElement("li");
            const link = document.createElement("a");
            link.href = `#${heading.id}`;
            link.textContent = label || heading.id;
            item.append(link);
            list.append(item);
            linksById.set(heading.id, link);
          });

          toc.hidden = false;

          const activate = (id) => {
            linksById.forEach((link) => link.classList.toggle("active", link === linksById.get(id)));
          };
          activate(headings[0].id);

          const observer = new IntersectionObserver((entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible[0]?.target.id) activate(visible[0].target.id);
          }, { rootMargin: "-30% 0px -60% 0px" });

          headings.forEach((heading) => observer.observe(heading));
        })();
      </script>
    )}
    <script is:inline>
      (() => {
        function figureFor(id) {
          const node = document.getElementById(id);
          return node?.closest(".figure") || node;
        }
        function pulse(el, cls, ms = 1200) {
          if (!el) return;
          el.classList.add(cls);
          window.setTimeout(() => el.classList.remove(cls), ms);
        }
        document.addEventListener("click", (event) => {
          const trigger = event.target.closest("[data-target-figure]");
          if (!trigger) return;
          const target = figureFor(trigger.dataset.targetFigure);
          if (!target) return;
          target.scrollIntoView({ behavior: "smooth", block: "center" });
          pulse(target, "is-pulsing", 1500);
          const preset = trigger.dataset.preset;
          if (preset) {
            const buttons = target.querySelectorAll("[data-fig1-preset],[data-fig2-preset],[data-fig3-preset],[data-fig4-preset],[data-fig5-preset],[data-fig-corr-preset],[data-fig2-filter]");
            const match = Array.from(buttons).find((button) => Object.values(button.dataset).includes(preset));
            match?.click();
          }
          const hint = trigger.dataset.hintControl;
          if (hint) pulse(document.getElementById(hint)?.closest(".control") || document.getElementById(hint), "control-hint", 1500);
        });
        function setupPreviewCanvas(canvas) {
          if (!canvas.dataset.logicalWidth) {
            canvas.dataset.logicalWidth = canvas.getAttribute("width") || String(canvas.width || 220);
            canvas.dataset.logicalHeight = canvas.getAttribute("height") || String(canvas.height || 54);
          }
          const w = Number(canvas.dataset.logicalWidth) || 220;
          const h = Number(canvas.dataset.logicalHeight) || 54;
          const rect = canvas.getBoundingClientRect();
          const cssWidth = rect.width || w;
          const cssHeight = rect.height || h;
          const dpr = Math.max(1, window.devicePixelRatio || 1);
          const backingWidth = Math.round(cssWidth * dpr);
          const backingHeight = Math.round(cssHeight * dpr);
          if (canvas.width !== backingWidth || canvas.height !== backingHeight) {
            canvas.width = backingWidth;
            canvas.height = backingHeight;
          }
          const ctx = canvas.getContext("2d");
          if (!ctx) return null;
          ctx.setTransform(cssWidth / w * dpr, 0, 0, cssHeight / h * dpr, 0, 0);
          return { ctx, w, h };
        }
        function drawPreview(canvas, t) {
          const setup = setupPreviewCanvas(canvas);
          if (!setup) return;
          const { ctx, w, h } = setup;
          const href = canvas.dataset.previewHref || "";
          ctx.clearRect(0, 0, w, h);
          ctx.fillStyle = "#f3f1ec";
          ctx.fillRect(0, 0, w, h);
          ctx.strokeStyle = "#d8d2c4";
          ctx.strokeRect(0.5, 0.5, w - 1, h - 1);
          const blue = "#1f4a8c", red = "#b8412a", green = "#2d7a3e", purple = "#6b4592";
          const key = href.toLowerCase();
          const plotX = 18;
          const plotY = 8;
          const plotW = w - 36;
          const plotH = h - 17;
          function axes() {
            ctx.strokeStyle = "#c9c1b2";
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(plotX, plotY + plotH);
            ctx.lineTo(plotX + plotW, plotY + plotH);
            ctx.moveTo(plotX, plotY);
            ctx.lineTo(plotX, plotY + plotH);
            ctx.stroke();
          }
          function curve(color, offset = 0) {
            ctx.strokeStyle = color;
            ctx.lineWidth = 2;
            ctx.beginPath();
            for (let i = 0; i <= plotW; i++) {
              const u = i / plotW;
              const y = plotY + plotH - (Math.exp(-Math.pow((u - 0.52) * 4.5, 2)) * 0.72 + 0.12 + offset) * plotH;
              i ? ctx.lineTo(plotX + i, y) : ctx.moveTo(plotX + i, y);
            }
            ctx.stroke();
          }
          function dot(x, y, r, color) {
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fill();
          }
          function line(x1, y1, x2, y2, color, width = 1.4, alpha = 1) {
            ctx.save();
            ctx.globalAlpha = alpha;
            ctx.strokeStyle = color;
            ctx.lineWidth = width;
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.stroke();
            ctx.restore();
          }
          function arrow(x1, y1, x2, y2, color, width = 1.4) {
            line(x1, y1, x2, y2, color, width);
            const a = Math.atan2(y2 - y1, x2 - x1);
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.moveTo(x2, y2);
            ctx.lineTo(x2 - 5 * Math.cos(a - 0.45), y2 - 5 * Math.sin(a - 0.45));
            ctx.lineTo(x2 - 5 * Math.cos(a + 0.45), y2 - 5 * Math.sin(a + 0.45));
            ctx.closePath();
            ctx.fill();
          }
          function box(x, y, bw, bh, color, fill = "rgba(31,74,140,0.08)") {
            ctx.fillStyle = fill;
            ctx.strokeStyle = color;
            ctx.lineWidth = 1.2;
            ctx.fillRect(x, y, bw, bh);
            ctx.strokeRect(x + 0.5, y + 0.5, bw - 1, bh - 1);
          }
          function tokenRow(x, y, count, active = -1) {
            for (let i = 0; i < count; i++) {
              const c = i === active ? red : i % 2 ? green : blue;
              box(x + i * 18, y, 12, 14, c, `${c}22`);
            }
          }
          function miniBars(x, y, values, colors) {
            values.forEach((v, i) => {
              ctx.fillStyle = colors[i % colors.length];
              ctx.fillRect(x + i * 9, y + 30 - v * 28, 6, v * 28);
            });
          }
          if (key.includes("monte-carlo") || key.includes("state-space-filtering") || key.includes("sampling-methods")) {
            axes();
            curve(blue);
            for (let i = 0; i < 14; i++) {
              const u = (i + 0.5) / 14;
              const jitter = Math.sin(t / 360 + i * 1.9) * 4;
              const y = plotY + plotH - (0.16 + Math.exp(-Math.pow((u - 0.52) * 4.5, 2)) * 0.62) * plotH + jitter;
              dot(plotX + u * plotW, y, 2.4, i % 3 === 0 ? red : green);
            }
          } else if (key.includes("qk-ov-circuits")) {
            tokenRow(20, 30, 5, 3);
            for (let r = 0; r < 4; r++) {
              for (let c = 0; c < 4; c++) {
                const v = Math.max(0.08, 0.7 - Math.abs(r - c) * 0.16 + Math.sin(t / 650 + r + c) * 0.08);
                ctx.fillStyle = `rgba(31,74,140,${v})`;
                ctx.fillRect(78 + c * 8, 12 + r * 8, 7, 7);
              }
            }
            arrow(104, 28, 142, 20, purple);
            arrow(104, 28, 142, 38, green);
            for (let i = 0; i < 4; i++) {
              line(150 + i * 8, 14, 166 + i * 8, 36, i % 2 ? green : purple, 2.1);
            }
            dot(104, 28, 3, red);
          } else if (key.includes("residual-stream-directions")) {
            line(26, 44, 190, 44, "#c9c1b2", 1.2);
            for (let i = 0; i < 7; i++) {
              const x = 34 + i * 24;
              const hgt = 15 + Math.sin(t / 550 + i) * 6;
              box(x - 4, 18, 8, 26, i % 2 ? green : blue, "rgba(255,255,255,0.45)");
              arrow(x, 41, x + 12, 41 - hgt, i % 3 === 0 ? red : purple, 1.5);
            }
          } else if (key.includes("attention-head-types")) {
            for (let row = 0; row < 2; row++) {
              for (let col = 0; col < 5; col++) {
                const ox = 28 + col * 34;
                const oy = 17 + row * 18;
                line(ox - 7, oy + 7, ox + 7, oy - 7, col % 2 ? green : blue, 1.4);
                line(ox, oy + 8, ox + 11, oy + 6 * Math.sin(t / 700 + col), row ? purple : red, 1.3);
                dot(ox - 8, oy + 8, 2.2, blue);
                dot(ox + 8, oy - 8, 2.2, red);
              }
            }
          } else if (key.includes("induction-heads")) {
            tokenRow(22, 12, 8, 6);
            tokenRow(22, 34, 8, 7);
            line(42, 27, 132, 12, purple, 1.5, 0.65);
            line(60, 27, 150, 12, purple, 1.5, 0.65);
            arrow(132, 34, 150, 34, red, 1.7);
            arrow(150, 34, 168, 34, red, 1.7);
          } else if (key.includes("logit-lens-tuned-lens")) {
            for (let i = 0; i < 6; i++) {
              const x = 28 + i * 20;
              box(x, 10, 12, 34, i % 2 ? green : blue, "rgba(255,255,255,0.45)");
              arrow(x + 6, 15, 160, 15 + i * 5, i < 3 ? blue : purple, 0.9);
            }
            miniBars(156, 12, [0.28, 0.45, 0.74, 0.5, 0.35], [blue, green, red, purple]);
          } else if (key.includes("probes-validity")) {
            axes();
            for (let i = 0; i < 18; i++) {
              const side = i % 2 ? -1 : 1;
              const x = plotX + 16 + i * 7.5;
              const y = plotY + plotH * 0.5 + side * (9 + Math.sin(t / 700 + i) * 5);
              dot(x, y, 2.3, side > 0 ? blue : red);
            }
            line(plotX + 18, plotY + plotH - 4, plotX + plotW - 18, plotY + 8, purple, 1.8);
          } else if (key.includes("structural-probes")) {
            const pts = [[52,14],[30,32],[74,32],[60,45],[98,45],[142,18],[164,36]];
            [[0,1],[0,2],[2,3],[2,4],[0,5],[5,6]].forEach(([a, b]) => line(pts[a][0], pts[a][1], pts[b][0], pts[b][1], "#8f8678", 1.2));
            pts.forEach((p, i) => dot(p[0], p[1], i % 2 ? 2.8 : 3.2, i % 3 === 0 ? red : blue));
            for (let r = 0; r < 4; r++) {
              for (let c = 0; c < 4; c++) {
                ctx.fillStyle = `rgba(107,69,146,${0.12 + Math.abs(r - c) * 0.09})`;
                ctx.fillRect(120 + c * 7, 11 + r * 7, 6, 6);
              }
            }
          } else if (key.includes("semantic-composition-probes")) {
            dot(48, 30, 4, blue);
            dot(88, 18, 4, green);
            dot(92, 42, 4, red);
            arrow(52, 29, 82, 20, blue, 1.5);
            arrow(54, 32, 86, 41, red, 1.5);
            arrow(98, 30, 154, 30, purple, 1.8);
            miniBars(158, 12, [0.35, 0.7, 0.42, 0.58], [green, blue, purple, red]);
          } else if (key.includes("bayesian-mdl-probes")) {
            axes();
            ctx.strokeStyle = blue;
            ctx.lineWidth = 1.8;
            ctx.beginPath();
            for (let i = 0; i <= plotW; i++) {
              const u = i / plotW;
              const y = plotY + plotH - (0.18 + 0.62 * (1 - Math.exp(-4 * u))) * plotH;
              i ? ctx.lineTo(plotX + i, y) : ctx.moveTo(plotX + i, y);
            }
            ctx.stroke();
            ctx.strokeStyle = red;
            ctx.beginPath();
            for (let i = 0; i <= plotW; i++) {
              const u = i / plotW;
              const y = plotY + plotH - (0.7 - 0.42 * u + Math.sin(t / 900 + u * 5) * 0.03) * plotH;
              i ? ctx.lineTo(plotX + i, y) : ctx.moveTo(plotX + i, y);
            }
            ctx.stroke();
          } else if (key.includes("causal-interventions")) {
            const pts = [[34,18],[76,18],[118,18],[160,18],[76,39],[118,39]];
            [[0,1],[1,2],[2,3],[1,4],[4,5],[5,3]].forEach(([a, b]) => arrow(pts[a][0], pts[a][1], pts[b][0], pts[b][1], a === 1 && b === 4 ? red : "#8f8678", 1.2));
            pts.forEach((p, i) => dot(p[0], p[1], i === 4 ? 4 : 3, i === 4 ? red : i % 2 ? blue : green));
            line(70, 33, 84, 45, red, 2);
            line(84, 33, 70, 45, red, 2);
          } else if (key.includes("variable-binding")) {
            tokenRow(25, 30, 7, 2);
            [[0,3,blue],[1,5,green],[2,6,red]].forEach(([a, b, c]) => {
              const x1 = 31 + a * 18, x2 = 31 + b * 18;
              ctx.strokeStyle = c;
              ctx.lineWidth = 1.5;
              ctx.beginPath();
              ctx.moveTo(x1, 29);
              ctx.quadraticCurveTo((x1 + x2) / 2, 8, x2, 29);
              ctx.stroke();
            });
          } else if (key.includes("represented-vs-expressed-knowledge")) {
            miniBars(28, 12, [0.78, 0.42, 0.3, 0.62, 0.48], [blue, green, purple, red]);
            arrow(82, 27, 126, 27, "#8f8678", 1.4);
            miniBars(132, 12, [0.26, 0.36, 0.68, 0.34, 0.46], [blue, green, red, purple]);
            line(36, 12, 54, 12, red, 2);
            line(148, 12, 166, 12, red, 2);
          } else if (key.includes("fisher-information")) {
            axes();
            curve(blue);
            const cx = plotX + plotW * 0.54;
            ctx.strokeStyle = red;
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(cx - 20, plotY + 18);
            ctx.lineTo(cx + 20, plotY + 18 + Math.sin(t / 500) * 3);
            ctx.stroke();
            ctx.strokeStyle = purple;
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(cx, plotY + 20, 15, Math.PI * 0.12, Math.PI * 0.88);
            ctx.stroke();
            dot(cx, plotY + 18, 3, red);
          } else if (key.includes("entropy-mutual-information")) {
            const cols = [blue, green, red, purple];
            for (let i = 0; i < 4; i++) {
              ctx.fillStyle = cols[i];
              const y = 13 + i * 7;
              ctx.globalAlpha = 0.24 + i * 0.06;
              ctx.fillRect(30 + i * 14, y, 82 - i * 9, 5);
              ctx.fillRect(112 - i * 6, y, 62 + i * 9, 5);
            }
            ctx.globalAlpha = 1;
            ctx.strokeStyle = "#8f8678";
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(88, 28, 20, 0, Math.PI * 2);
            ctx.arc(122, 28, 20, 0, Math.PI * 2);
            ctx.stroke();
            ctx.fillStyle = "rgba(31,74,140,0.25)";
            ctx.fillRect(92, 16, 26, 24);
          } else if (key.includes("distance-correlation")) {
            axes();
            ctx.strokeStyle = "rgba(107,69,146,0.28)";
            ctx.lineWidth = 1;
            for (let i = 0; i < 7; i++) {
              const ax = plotX + 18 + i * 18;
              const ay = plotY + 26 + Math.sin(i * 1.3) * 10;
              ctx.beginPath();
              ctx.moveTo(ax, ay);
              ctx.lineTo(ax + 34, plotY + 23 + Math.cos(i * 1.1) * 11);
              ctx.stroke();
            }
            for (let i = 0; i < 12; i++) {
              const x = plotX + 14 + i * 13;
              const y = plotY + 26 + Math.sin(i * 0.9 + t / 700) * 11;
              dot(x, y, 2.5, i % 2 ? blue : red);
            }
          } else if (key.includes("sufficient-statistics")) {
            for (let i = 0; i < 16; i++) {
              const x = 24 + (i % 8) * 14;
              const y = 15 + Math.floor(i / 8) * 17 + Math.sin(t / 500 + i) * 1.5;
              dot(x, y, 2.6, i % 3 === 0 ? red : blue);
              ctx.strokeStyle = "rgba(107,69,146,0.18)";
              ctx.beginPath();
              ctx.moveTo(x + 3, y);
              ctx.lineTo(156, 27);
              ctx.stroke();
            }
            ctx.strokeStyle = green;
            ctx.lineWidth = 2;
            ctx.strokeRect(150, 17, 42, 22);
            ctx.fillStyle = green;
            ctx.font = "bold 14px serif";
            ctx.fillText("T(x)", 158, 32);
          } else if (key.includes("attention")) {
            tokenRow(24, 34, 7, 4);
            for (let i = 0; i < 7; i++) {
              const x = 30 + i * 18;
              const weight = 0.15 + Math.exp(-Math.pow((i - 4) / 1.8, 2)) * 0.65;
              line(x, 34, 106, 14, i === 4 ? red : blue, 1 + weight * 2, weight);
            }
            dot(106, 14, 4, red);
            miniBars(146, 13, [0.18, 0.42, 0.74, 0.36], [blue, green, red, purple]);
          } else if (key.includes("kv-cache-memory")) {
            for (let i = 0; i < 7; i++) {
              const x = 26 + i * 23;
              ctx.fillStyle = i < 5 ? "rgba(31,74,140,0.25)" : "rgba(184,65,42,0.18)";
              ctx.fillRect(x, 12, 14, 30);
              ctx.strokeStyle = i < 5 ? blue : red;
              ctx.strokeRect(x + 0.5, 12.5, 13, 29);
              ctx.fillStyle = i % 2 ? green : purple;
              ctx.fillRect(x + 3, 16, 8, 5 + ((i + Math.floor(t / 500)) % 3) * 3);
              ctx.fillRect(x + 3, 31, 8, 4);
            }
            ctx.strokeStyle = "#8f8678";
            ctx.beginPath();
            ctx.moveTo(28, 47);
            ctx.lineTo(176, 47);
            ctx.stroke();
          } else if (href.includes("markov")) {
            const vals = [0.15, 0.35, 0.5].map((v, i) => v + 0.08 * Math.sin(t / 600 + i));
            vals.forEach((v, i) => { ctx.fillStyle = [blue, red, green][i]; ctx.fillRect(18 + i * 44, h - 8 - v * 42, 26, v * 42); });
          } else if (key.includes("psd") || key.includes("lti") || key.includes("gaussian")) {
            ctx.beginPath();
            for (let x = 0; x < w; x++) {
              const y = h * 0.54 + Math.sin(x / 12 + t / 500) * 8 + Math.sin(x / 31) * 5;
              x ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
            }
            ctx.strokeStyle = key.includes("gaussian") ? green : blue;
            ctx.lineWidth = 2;
            ctx.stroke();
          } else if (key.includes("poisson-process")) {
            axes();
            ctx.strokeStyle = "#8f8678";
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(plotX, plotY + plotH - 6);
            ctx.lineTo(plotX + plotW, plotY + plotH - 6);
            ctx.stroke();
            const arrivals = [];
            let s = 0;
            for (let i = 0; i < 9; i++) {
              s += 0.6 + ((Math.sin(i * 2.1 + t / 700) + 1) * 0.7);
              arrivals.push(s);
            }
            const span = arrivals[arrivals.length - 1] + 0.4;
            ctx.strokeStyle = blue;
            ctx.lineWidth = 2;
            arrivals.forEach((a, i) => {
              const x = plotX + (a / span) * plotW;
              ctx.beginPath();
              ctx.moveTo(x, plotY + plotH - 6);
              ctx.lineTo(x, plotY + plotH - 18);
              ctx.stroke();
              dot(x, plotY + plotH - 6, 2.2, i % 2 ? red : blue);
            });
          } else if (key.includes("named-distributions") || key.includes("exponential-family")) {
            axes();
            const means = key.includes("exponential-family") ? [0.32, 0.5, 0.68] : [0.28, 0.48, 0.72];
            means.forEach((mean, j) => {
              ctx.strokeStyle = [blue, red, green][j];
              ctx.lineWidth = 1.6;
              ctx.beginPath();
              for (let i = 0; i <= plotW; i++) {
                const u = (i / plotW - mean) * (j === 1 ? 5 : 7);
                const y = plotY + plotH - (Math.exp(-u * u) * (0.5 + j * 0.08) + 0.07) * plotH;
                i ? ctx.lineTo(plotX + i, y) : ctx.moveTo(plotX + i, y);
              }
              ctx.stroke();
            });
          } else if (key.includes("calculus-of-variations")) {
            ctx.strokeStyle = "#c9c1b2";
            ctx.lineWidth = 1;
            for (let y = 14; y <= 42; y += 7) line(20, y, 190, y, "#d8d2c4", 0.8);
            [[blue, 0], [purple, 0.8], [red, 1.6]].forEach(([color, phase], j) => {
              ctx.strokeStyle = color;
              ctx.globalAlpha = 0.45 + j * 0.18;
              ctx.lineWidth = 1.5 + j * 0.3;
              ctx.beginPath();
              for (let i = 0; i <= 150; i++) {
                const u = i / 150;
                const y = 40 - 25 * Math.sin(u * Math.PI) + Math.sin(u * 8 + t / 700 + phase) * (4 - j);
                i ? ctx.lineTo(32 + i, y) : ctx.moveTo(32 + i, y);
              }
              ctx.stroke();
              ctx.globalAlpha = 1;
            });
          } else if (key.includes("bayesian-graphical-models") || key.includes("hidden-markov-models")) {
            const pts = key.includes("hidden-markov-models")
              ? [[30,22],[70,22],[110,22],[150,22],[30,40],[70,40],[110,40],[150,40]]
              : [[48,18],[86,18],[124,18],[68,40],[112,40],[156,32]];
            const edges = key.includes("hidden-markov-models")
              ? [[0,1],[1,2],[2,3],[0,4],[1,5],[2,6],[3,7]]
              : [[0,1],[1,2],[0,3],[1,3],[1,4],[2,4],[4,5]];
            edges.forEach(([a, b]) => arrow(pts[a][0], pts[a][1], pts[b][0], pts[b][1], "#8f8678", 1));
            pts.forEach((p, i) => dot(p[0], p[1], 3, i % 2 ? blue : green));
          } else if (key.includes("hierarchical-bayes")) {
            dot(104, 12, 4, purple);
            for (let i = 0; i < 5; i++) {
              const x = 36 + i * 34;
              arrow(104, 16, x, 36, "#8f8678", 1);
              dot(x, 38, 3.3, i % 2 ? blue : red);
              line(x - 8, 45, x + 8, 45 - Math.sin(t / 600 + i) * 5, i % 2 ? blue : red, 1.5);
            }
          } else if (key.includes("bayesian-regression") || key.includes("posterior-summaries")) {
            axes();
            if (key.includes("posterior-summaries")) {
              curve(blue);
              [0.44, 0.52, 0.62].forEach((u, i) => line(plotX + u * plotW, plotY + 8, plotX + u * plotW, plotY + plotH, [red, green, purple][i], 1.7));
            } else {
              line(plotX + 4, plotY + plotH - 9, plotX + plotW - 4, plotY + 12, blue, 2);
              for (let i = 0; i < 14; i++) {
                const u = i / 13;
                const y = plotY + plotH - 10 - u * (plotH - 20) + Math.sin(t / 600 + i) * 5;
                dot(plotX + 8 + u * (plotW - 16), y, 2.2, i % 2 ? red : green);
              }
            }
          } else if (key.includes("bayesian-neural-networks")) {
            axes();
            for (let j = 0; j < 5; j++) {
              ctx.strokeStyle = `rgba(${j % 2 ? "184,65,42" : "31,74,140"},${0.22 + j * 0.09})`;
              ctx.lineWidth = 1.4;
              ctx.beginPath();
              for (let i = 0; i <= plotW; i++) {
                const u = i / plotW;
                const y = plotY + plotH * (0.55 - 0.28 * Math.sin(u * Math.PI * 1.5 + j * 0.45 + t / 900));
                i ? ctx.lineTo(plotX + i, y) : ctx.moveTo(plotX + i, y);
              }
              ctx.stroke();
            }
          } else if (key.includes("vb-gaussian-mixture")) {
            for (let i = 0; i < 3; i++) {
              ctx.save();
              ctx.translate(56 + i * 48, 28 + Math.sin(t / 700 + i) * 2);
              ctx.rotate((i - 1) * 0.35);
              ctx.scale(1.7, 0.85);
              ctx.strokeStyle = [blue, red, green][i];
              ctx.lineWidth = 1.4;
              ctx.beginPath();
              ctx.arc(0, 0, 10, 0, Math.PI * 2);
              ctx.stroke();
              ctx.restore();
              dot(56 + i * 48, 28, 2.5, [blue, red, green][i]);
            }
          } else if (key.includes("information-geometry")) {
            const a = [54, 42], b = [104, 12], c = [154, 42];
            [a, b, c].forEach((p, i) => dot(p[0], p[1], 3.5, [blue, red, green][i]));
            line(a[0], a[1], b[0], b[1], "#8f8678", 1);
            line(b[0], b[1], c[0], c[1], "#8f8678", 1);
            line(c[0], c[1], a[0], a[1], "#8f8678", 1);
            ctx.strokeStyle = purple;
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(68, 37);
            ctx.quadraticCurveTo(104, 12 + Math.sin(t / 700) * 3, 140, 37);
            ctx.stroke();
          } else if (key.includes("optimal-transport")) {
            const left = [], right = [];
            for (let i = 0; i < 6; i++) {
              left.push({ x: plotX + 8, y: plotY + 8 + i * 6 + Math.sin(t / 600 + i) * 1.5 });
              right.push({ x: plotX + plotW - 8, y: plotY + 10 + i * 6 + Math.cos(t / 600 + i * 1.3) * 1.5 });
            }
            ctx.strokeStyle = "rgba(107,69,146,0.35)";
            ctx.lineWidth = 1;
            for (let i = 0; i < 6; i++) {
              const j = (i + Math.floor(t / 1200)) % 6;
              ctx.beginPath();
              ctx.moveTo(left[i].x + 3, left[i].y);
              ctx.lineTo(right[j].x - 3, right[j].y);
              ctx.stroke();
            }
            left.forEach(p => dot(p.x, p.y, 2.6, blue));
            right.forEach(p => dot(p.x, p.y, 2.6, red));
          } else if (key.includes("hypothesis-testing")) {
            axes();
            function bell(cx, color, fill) {
              ctx.beginPath();
              for (let i = 0; i <= plotW; i++) {
                const u = (i / plotW - cx) * 5;
                const y = plotY + plotH - (Math.exp(-u * u) * 0.7 + 0.08) * plotH;
                i ? ctx.lineTo(plotX + i, y) : ctx.moveTo(plotX + i, y);
              }
              ctx.strokeStyle = color;
              ctx.lineWidth = 1.8;
              ctx.stroke();
              if (fill) {
                ctx.fillStyle = fill;
                ctx.lineTo(plotX + plotW, plotY + plotH);
                ctx.lineTo(plotX, plotY + plotH);
                ctx.closePath();
                ctx.fill();
              }
            }
            bell(0.38, blue);
            bell(0.66, red);
            const cutU = 0.78 + Math.sin(t / 700) * 0.04;
            const cutX = plotX + cutU * plotW;
            ctx.fillStyle = "rgba(184,65,42,0.22)";
            ctx.beginPath();
            ctx.moveTo(cutX, plotY + plotH);
            for (let i = Math.floor(cutU * plotW); i <= plotW; i++) {
              const u = (i / plotW - 0.66) * 5;
              const y = plotY + plotH - (Math.exp(-u * u) * 0.7 + 0.08) * plotH;
              ctx.lineTo(plotX + i, y);
            }
            ctx.lineTo(plotX + plotW, plotY + plotH);
            ctx.closePath();
            ctx.fill();
            ctx.strokeStyle = "#8f8678";
            ctx.setLineDash([3, 3]);
            ctx.beginPath();
            ctx.moveTo(cutX, plotY);
            ctx.lineTo(cutX, plotY + plotH);
            ctx.stroke();
            ctx.setLineDash([]);
          } else if (key.includes("conjugate-prior") || key.includes("choosing-a-prior")) {
            axes();
            const shift = Math.sin(t / 900) * 0.08;
            function pdf(color, mean, scale, width) {
              ctx.beginPath();
              for (let i = 0; i <= plotW; i++) {
                const u = (i / plotW - mean) * scale;
                const y = plotY + plotH - (Math.exp(-u * u) * 0.7 + 0.08) * plotH;
                i ? ctx.lineTo(plotX + i, y) : ctx.moveTo(plotX + i, y);
              }
              ctx.strokeStyle = color;
              ctx.lineWidth = width;
              ctx.stroke();
            }
            pdf("rgba(107,69,146,0.55)", 0.5, 3.2, 1.6);
            pdf(blue, 0.5 + shift, 5.0, 2);
          } else if (key.includes("modes-of-convergence")) {
            axes();
            for (let k = 0; k < 5; k++) {
              const phase = (t / 900 + k * 0.6) % 5;
              const sharpness = 1 + phase * 1.4;
              const alpha = 0.18 + k * 0.14;
              ctx.strokeStyle = `rgba(31,74,140,${alpha})`;
              ctx.lineWidth = 1.4;
              ctx.beginPath();
              for (let i = 0; i <= plotW; i++) {
                const u = (i / plotW - 0.52) * 4.5 * sharpness;
                const y = plotY + plotH - (Math.exp(-u * u) * 0.78 + 0.08) * plotH;
                i ? ctx.lineTo(plotX + i, y) : ctx.moveTo(plotX + i, y);
              }
              ctx.stroke();
            }
            ctx.strokeStyle = red;
            ctx.lineWidth = 2;
            ctx.beginPath();
            const tx = plotX + 0.52 * plotW;
            ctx.moveTo(tx, plotY + 4);
            ctx.lineTo(tx, plotY + plotH);
            ctx.stroke();
          } else if (key.includes("kl") || key.includes("variational") || key.includes("vi-regression")) {
            ctx.fillStyle = "rgba(31,74,140,0.55)";
            ctx.fillRect(78, 14, 30, 28);
            ctx.fillStyle = "rgba(184,65,42,0.55)";
            ctx.fillRect(78, 6, 30, 8 + 6 * Math.sin(t / 500));
          } else if (key.includes("measure")) {
            ctx.fillStyle = "rgba(31,74,140,0.25)";
            ctx.beginPath(); ctx.arc(78, 28, 18, 0, Math.PI * 2); ctx.fill();
            ctx.fillStyle = "rgba(184,65,42,0.25)";
            ctx.beginPath(); ctx.arc(98, 28, 18, 0, Math.PI * 2); ctx.fill();
          } else {
            const pts = Array.from({ length: 10 }, (_, i) => ({
              x: 26 + i * 18,
              y: 28 + Math.sin(t / 650 + i * 1.3) * 14,
            }));
            pts.forEach((p, i) => {
              if (i > 0) line(pts[i - 1].x, pts[i - 1].y, p.x, p.y, i % 2 ? blue : purple, 1.2, 0.45);
              if (i > 2 && i % 3 === 0) line(pts[i - 3].x, pts[i - 3].y, p.x, p.y, green, 1, 0.25);
            });
            pts.forEach((p, i) => dot(p.x, p.y, 2.6, [blue, red, green, purple][i % 4]));
          }
        }
        const previews = Array.from(document.querySelectorAll(".live-preview"));
        if (previews.length) {
          const animate = (t) => {
            previews.forEach((canvas) => drawPreview(canvas, t));
            requestAnimationFrame(animate);
          };
          requestAnimationFrame(animate);
        }
      })();
    </script>
  </body>
</html>
