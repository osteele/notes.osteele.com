      </article>
  </div>

  <script is:inline>
    // ===================================================================
    // Math primitives
    // ===================================================================
    function gauss() {
      let u = 0, v = 0;
      while (u === 0) u = Math.random();
      while (v === 0) v = Math.random();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }
    function ranks(arr) {
      const n = arr.length;
      const idx = Array.from({ length: n }, (_, i) => i);
      idx.sort((a, b) => arr[a] - arr[b]);
      const r = new Array(n);
      // average ranks for ties
      let i = 0;
      while (i < n) {
        let j = i;
        while (j + 1 < n && arr[idx[j + 1]] === arr[idx[i]]) j++;
        const avg = (i + j + 2) / 2; // 1-indexed average rank
        for (let k = i; k <= j; k++) r[idx[k]] = avg;
        i = j + 1;
      }
      return r;
    }
    function spearman(X, Y) {
      return pearson(ranks(X), ranks(Y));
    }
    function pearson(X, Y) {
      const n = X.length;
      let mx = 0, my = 0;
      for (let i = 0; i < n; i++) { mx += X[i]; my += Y[i]; }
      mx /= n; my /= n;
      let num = 0, sx = 0, sy = 0;
      for (let i = 0; i < n; i++) {
        const dx = X[i] - mx, dy = Y[i] - my;
        num += dx * dy; sx += dx * dx; sy += dy * dy;
      }
      return sx * sy === 0 ? 0 : num / Math.sqrt(sx * sy);
    }
    function distMatrix1D(X) {
      const n = X.length;
      const D = new Float64Array(n * n);
      for (let i = 0; i < n; i++) {
        for (let j = i + 1; j < n; j++) {
          const d = Math.abs(X[i] - X[j]);
          D[i * n + j] = d;
          D[j * n + i] = d;
        }
      }
      return D;
    }
    function doubleCenter(D, n) {
      const A = new Float64Array(n * n);
      const rowMean = new Float64Array(n);
      const colMean = new Float64Array(n);
      let grand = 0;
      for (let i = 0; i < n; i++) {
        let s = 0;
        for (let j = 0; j < n; j++) s += D[i * n + j];
        rowMean[i] = s / n;
        grand += s;
      }
      grand /= (n * n);
      for (let j = 0; j < n; j++) {
        let s = 0;
        for (let i = 0; i < n; i++) s += D[i * n + j];
        colMean[j] = s / n;
      }
      for (let i = 0; i < n; i++)
        for (let j = 0; j < n; j++)
          A[i * n + j] = D[i * n + j] - rowMean[i] - colMean[j] + grand;
      return A;
    }
    function uCenter(D, n) {
      if (n < 4) return new Float64Array(n * n);
      const A = new Float64Array(n * n);
      const rowSum = new Float64Array(n);
      let grand = 0;
      for (let i = 0; i < n; i++) {
        let s = 0;
        for (let j = 0; j < n; j++) s += D[i * n + j];
        rowSum[i] = s;
        grand += s;
      }
      for (let i = 0; i < n; i++)
        for (let j = 0; j < n; j++) {
          if (i === j) { A[i * n + j] = 0; continue; }
          A[i * n + j] = D[i * n + j]
            - rowSum[i] / (n - 2)
            - rowSum[j] / (n - 2)
            + grand / ((n - 1) * (n - 2));
        }
      return A;
    }
    function frobInner(A, B, n) {
      let s = 0;
      for (let k = 0; k < n * n; k++) s += A[k] * B[k];
      return s;
    }
    function uInner(A, B, n) { return frobInner(A, B, n) / (n * (n - 3)); }
    function uNorm(A, n) { return Math.sqrt(Math.max(0, uInner(A, A, n))); }
    function dCovBiased(X, Y) {
      const n = X.length;
      const A = doubleCenter(distMatrix1D(X), n);
      const B = doubleCenter(distMatrix1D(Y), n);
      return frobInner(A, B, n) / (n * n);
    }
    function dCovUnbiased(X, Y) {
      const n = X.length;
      const A = uCenter(distMatrix1D(X), n);
      const B = uCenter(distMatrix1D(Y), n);
      return uInner(A, B, n);
    }
    function dCor(X, Y) {
      const n = X.length;
      const A = doubleCenter(distMatrix1D(X), n);
      const B = doubleCenter(distMatrix1D(Y), n);
      const xy = frobInner(A, B, n) / (n * n);
      const xx = frobInner(A, A, n) / (n * n);
      const yy = frobInner(B, B, n) / (n * n);
      if (xx <= 0 || yy <= 0) return 0;
      const v = xy / Math.sqrt(xx * yy);
      return v <= 0 ? 0 : Math.sqrt(v);
    }
    function uDCor(Atil, Btil, n) {
      const xy = uInner(Atil, Btil, n);
      const xx = uInner(Atil, Atil, n);
      const yy = uInner(Btil, Btil, n);
      if (xx <= 0 || yy <= 0) return 0;
      return xy / Math.sqrt(xx * yy);
    }

    // ===================================================================
    // Plot helpers
    // ===================================================================
    function clearSVG(svg) { while (svg.firstChild) svg.removeChild(svg.firstChild); }
    function el(tag, attrs, text) {
      const e = document.createElementNS("http://www.w3.org/2000/svg", tag);
      for (const k in attrs) e.setAttribute(k, attrs[k]);
      if (text != null) e.textContent = text;
      return e;
    }
    function autoExtent(arr, pad = 0.1) {
      let lo = Infinity, hi = -Infinity;
      for (const v of arr) { if (v < lo) lo = v; if (v > hi) hi = v; }
      if (lo === hi) { lo -= 1; hi += 1; }
      const r = hi - lo;
      return [lo - r * pad, hi + r * pad];
    }
    function scatter(svg, X, Y, w, h, opts) {
      clearSVG(svg);
      opts = opts || {};
      const pad = 18;
      const xExt = opts.xExt || autoExtent(X);
      const yExt = opts.yExt || autoExtent(Y);
      const xs = v => pad + (v - xExt[0]) / (xExt[1] - xExt[0]) * (w - 2 * pad);
      const ys = v => h - pad - (v - yExt[0]) / (yExt[1] - yExt[0]) * (h - 2 * pad);
      svg.appendChild(el("line", { class: "axis", x1: pad, y1: h - pad, x2: w - pad, y2: h - pad }));
      svg.appendChild(el("line", { class: "axis", x1: pad, y1: pad, x2: pad, y2: h - pad }));
      for (let i = 0; i < X.length; i++) {
        svg.appendChild(el("circle", { cx: xs(X[i]), cy: ys(Y[i]), r: 2.4, class: "point" }));
      }
      return { xs, ys, xExt, yExt };
    }
    function heatmap(svg, A, n, w, h, scale) {
      clearSVG(svg);
      let maxAbs = scale != null ? scale : 0;
      if (scale == null) {
        for (let k = 0; k < n * n; k++) {
          const a = Math.abs(A[k]);
          if (a > maxAbs) maxAbs = a;
        }
      }
      if (maxAbs === 0) maxAbs = 1;
      const cw = w / n, ch = h / n;
      for (let i = 0; i < n; i++) {
        for (let j = 0; j < n; j++) {
          const v = Math.max(-1, Math.min(1, A[i * n + j] / maxAbs));
          let r, g, b;
          if (v > 0) { // positive: white -> blue
            r = Math.round(255 - 218 * v);
            g = Math.round(255 - 156 * v);
            b = Math.round(255 - 20 * v);
          } else {     // negative: white -> red
            r = Math.round(255 + 35 * v);
            g = Math.round(255 + 217 * v);
            b = Math.round(255 + 217 * v);
          }
          svg.appendChild(el("rect", {
            x: j * cw, y: i * ch, width: cw + 0.5, height: ch + 0.5,
            fill: `rgb(${r},${g},${b})`
          }));
        }
      }
    }
    function fmt(x, d = 3) {
      if (!isFinite(x)) return "—";
      return x.toFixed(d);
    }
    function fmtSigned(x, d = 3) {
      if (!isFinite(x)) return "—";
      return (x >= 0 ? "+" : "") + x.toFixed(d);
    }

    // ===================================================================
    // Sample generators
    // ===================================================================
    function genSample(shape, n, noise) {
      const X = new Array(n), Y = new Array(n);
      for (let i = 0; i < n; i++) {
        const x = Math.random() * 2 - 1;
        let y;
        switch (shape) {
          case "linear":    y = 0.9 * x; break;
          case "quadratic": y = 1.4 * x * x - 0.5; break;
          case "sine":      y = Math.sin(x * Math.PI * 1.8) * 0.7; break;
          case "circle": {
            const t = Math.random() * 2 * Math.PI;
            X[i] = 0.85 * Math.cos(t) + noise * gauss();
            Y[i] = 0.85 * Math.sin(t) + noise * gauss();
            continue;
          }
          case "cross": {
            const s = Math.random() < 0.5 ? 1 : -1;
            X[i] = x; Y[i] = s * x + noise * gauss();
            continue;
          }
          case "independent": y = Math.random() * 2 - 1; break;
          default: y = 0;
        }
        X[i] = x + noise * gauss() * 0.4;
        Y[i] = y + noise * gauss();
      }
      return { X, Y };
    }

    // ===================================================================
    // Section 1 — Pearson vs dCor
    // ===================================================================
    function s1() {
      const shapeSel = document.getElementById("d1-shape");
      const noiseSlider = document.getElementById("d1-noise");
      const noiseVal = document.getElementById("d1-noise-val");
      const resampleBtn = document.getElementById("d1-resample");
      const svg = document.getElementById("d1-scatter");
      const elPear = document.getElementById("d1-pearson");
      const elSpear = document.getElementById("d1-spearman");
      const elDcor = document.getElementById("d1-dcor");
      let sample;
      function regen() {
        const noise = +noiseSlider.value / 100;
        noiseVal.textContent = noise.toFixed(2);
        sample = genSample(shapeSel.value, 120, noise);
        redraw();
      }
      function redraw() {
        scatter(svg, sample.X, sample.Y, 360, 220);
        const r = pearson(sample.X, sample.Y);
        const sp = spearman(sample.X, sample.Y);
        const dc = dCor(sample.X, sample.Y);
        elPear.textContent = fmtSigned(r);
        elPear.style.color = Math.abs(r) > 0.2 ? "var(--accent)" : "var(--text-dim)";
        elSpear.textContent = fmtSigned(sp);
        elSpear.style.color = Math.abs(sp) > 0.2 ? "var(--accent)" : "var(--text-dim)";
        elDcor.textContent = fmt(dc);
        elDcor.style.color = dc > 0.2 ? "var(--accent)" : "var(--text-dim)";
      }
      shapeSel.addEventListener("change", regen);
      noiseSlider.addEventListener("input", regen);
      resampleBtn.addEventListener("click", regen);
      regen();
    }

    // ===================================================================
    // Section 2 — Bias plot
    // ===================================================================
    function s2() {
      const scenarioSel = document.getElementById("d2-scenario");
      const repsSel = document.getElementById("d2-reps");
      const runBtn = document.getElementById("d2-run");
      const progress = document.getElementById("d2-progress");
      const svg = document.getElementById("d2-plot");
      const nGrid = [8, 12, 18, 26, 38, 56, 80, 120];
      let runSeq = 0;
      let runTimer = 0;

      function genPair(scenario, n) {
        const X = new Array(n), Y = new Array(n);
        for (let i = 0; i < n; i++) {
          X[i] = gauss();
          if (scenario === "indep") Y[i] = gauss();
          else                      Y[i] = X[i] * X[i] + 0.7 * gauss();
        }
        return { X, Y };
      }

      function drawAxes(truth, yMin, yMax) {
        clearSVG(svg);
        const w = 540, h = 280;
        const pad = { l: 56, r: 16, t: 14, b: 38 };
        const xMin = Math.log(nGrid[0]) - 0.05;
        const xMax = Math.log(nGrid[nGrid.length - 1]) + 0.05;
        const xs = lv => pad.l + (lv - xMin) / (xMax - xMin) * (w - pad.l - pad.r);
        const ys = v => h - pad.b - (v - yMin) / (yMax - yMin) * (h - pad.t - pad.b);

        // axes
        svg.appendChild(el("line", { class: "axis", x1: pad.l, y1: h - pad.b, x2: w - pad.r, y2: h - pad.b }));
        svg.appendChild(el("line", { class: "axis", x1: pad.l, y1: pad.t, x2: pad.l, y2: h - pad.b }));
        // x ticks (powers of n in nGrid)
        nGrid.forEach(nn => {
          const x = xs(Math.log(nn));
          svg.appendChild(el("line", { class: "grid-line", x1: x, y1: pad.t, x2: x, y2: h - pad.b }));
          svg.appendChild(el("text", { x, y: h - pad.b + 14, class: "axis-label", "text-anchor": "middle" }, "" + nn));
        });
        svg.appendChild(el("text", { x: (pad.l + w - pad.r) / 2, y: h - 6, class: "axis-label", "text-anchor": "middle" }, "sample size n"));
        // y ticks
        const yTicks = niceTicks(yMin, yMax, 6);
        yTicks.forEach(t => {
          const y = ys(t);
          svg.appendChild(el("line", { class: "grid-line", x1: pad.l, y1: y, x2: w - pad.r, y2: y }));
          svg.appendChild(el("text", { x: pad.l - 6, y: y + 3, class: "axis-label", "text-anchor": "end" }, t.toFixed(3)));
        });
        svg.appendChild(el("text", { x: 12, y: (pad.t + h - pad.b) / 2, class: "axis-label", "text-anchor": "middle", transform: `rotate(-90, 12, ${(pad.t + h - pad.b) / 2})` }, "estimator value"));

        // truth line
        const yT = ys(truth);
        svg.appendChild(el("line", { x1: pad.l, x2: w - pad.r, y1: yT, y2: yT, stroke: "var(--pos)", "stroke-width": 1.5, "stroke-dasharray": "5 3" }));
        svg.appendChild(el("text", { x: w - pad.r - 4, y: yT - 4, class: "axis-label", "text-anchor": "end", fill: "var(--pos)" }, `truth ≈ ${truth.toFixed(3)}`));

        return { xs, ys, w, h, pad };
      }

      function niceTicks(lo, hi, n) {
        const range = hi - lo;
        const step = Math.pow(10, Math.floor(Math.log10(range / n)));
        const steps = [1, 2, 2.5, 5, 10].map(m => m * step);
        const best = steps.reduce((a, b) => Math.abs(range / b - n) < Math.abs(range / a - n) ? b : a);
        const ticks = [];
        const start = Math.ceil(lo / best) * best;
        for (let v = start; v <= hi + 1e-12; v += best) ticks.push(+v.toFixed(10));
        return ticks;
      }

      async function run(runId) {
        runBtn.disabled = true;
        const scenario = scenarioSel.value;
        const reps = +repsSel.value;
        // First estimate truth with a big sample
        let truth = 0;
        if (scenario !== "indep") {
          const big = genPair(scenario, 400);
          truth = dCovUnbiased(big.X, big.Y);
        }
        const biasedMeans = [], unbiasedMeans = [];
        const biasedErr = [], unbiasedErr = [];
        for (let idx = 0; idx < nGrid.length; idx++) {
          const n = nGrid[idx];
          progress.textContent = `n=${n} (${idx + 1}/${nGrid.length})…`;
          // yield to UI
          await new Promise(r => setTimeout(r, 0));
          if (runId !== runSeq) return;
          let sumB = 0, sumU = 0, sumB2 = 0, sumU2 = 0;
          for (let r = 0; r < reps; r++) {
            const { X, Y } = genPair(scenario, n);
            const b = dCovBiased(X, Y);
            const u = dCovUnbiased(X, Y);
            sumB += b; sumU += u; sumB2 += b * b; sumU2 += u * u;
          }
          const mB = sumB / reps, mU = sumU / reps;
          biasedMeans.push(mB); unbiasedMeans.push(mU);
          biasedErr.push(Math.sqrt(Math.max(0, sumB2 / reps - mB * mB) / reps));
          unbiasedErr.push(Math.sqrt(Math.max(0, sumU2 / reps - mU * mU) / reps));
        }
        progress.textContent = "";

        // y extent
        const allVals = biasedMeans.concat(unbiasedMeans).concat([truth, 0]);
        let yMin = Math.min(...allVals), yMax = Math.max(...allVals);
        const yPad = (yMax - yMin) * 0.15 + 1e-4;
        yMin -= yPad; yMax += yPad;
        const { xs, ys, w, pad } = drawAxes(truth, yMin, yMax);
        const xMin = Math.log(nGrid[0]) - 0.05;
        const xMax = Math.log(nGrid[nGrid.length - 1]) + 0.05;

        // zero line if differs from truth
        if (Math.abs(truth) > 1e-6) {
          const y0 = ys(0);
          svg.appendChild(el("line", { x1: pad.l, x2: w - pad.r, y1: y0, y2: y0, stroke: "var(--border)", "stroke-width": 1, "stroke-dasharray": "2 3" }));
        }

        function plotLine(means, errs, color, label, labelDx, labelDy) {
          let pathD = "";
          nGrid.forEach((nn, i) => {
            const x = xs(Math.log(nn));
            const y = ys(means[i]);
            pathD += (i === 0 ? "M" : "L") + x + "," + y + " ";
            // error band
            const yUp = ys(means[i] + errs[i]);
            const yDn = ys(means[i] - errs[i]);
            svg.appendChild(el("line", { x1: x, x2: x, y1: yUp, y2: yDn, stroke: color, "stroke-width": 1, opacity: 0.4 }));
            svg.appendChild(el("circle", { cx: x, cy: y, r: 3, fill: color }));
          });
          svg.appendChild(el("path", { d: pathD, fill: "none", stroke: color, "stroke-width": 1.8 }));
          // label at the end
          const last = nGrid.length - 1;
          svg.appendChild(el("text", {
            x: xs(Math.log(nGrid[last])) + (labelDx || 6),
            y: ys(means[last]) + (labelDy || 4),
            class: "axis-label",
            fill: color,
            "font-weight": 600
          }, label));
        }
        plotLine(biasedMeans, biasedErr, "var(--neg)", "V²ₙ", -28, -8);
        plotLine(unbiasedMeans, unbiasedErr, "var(--accent)", "(Ã·B̃)", -38, 14);

        if (runId === runSeq) runBtn.disabled = false;
      }

      function runNow() {
        clearTimeout(runTimer);
        run(++runSeq);
      }
      function scheduleRun() {
        clearTimeout(runTimer);
        const nextRun = ++runSeq;
        progress.textContent = "updating…";
        runTimer = window.setTimeout(() => run(nextRun), 150);
      }

      runBtn.addEventListener("click", runNow);
      scenarioSel.addEventListener("change", scheduleRun);
      repsSel.addEventListener("change", scheduleRun);
      runNow();
    }

    // ===================================================================
    // Section 3 — Projection geometry
    // ===================================================================
    function s3() {
      const sxSlider = document.getElementById("d3-sx");
      const syEl = document.getElementById("d3-sy");
      const dxySlider = document.getElementById("d3-dxy");
      const sxVal = document.getElementById("d3-sx-val");
      const syVal = document.getElementById("d3-sy-val");
      const dxyVal = document.getElementById("d3-dxy-val");
      const resampleBtn = document.getElementById("d3-resample");
      const svg = document.getElementById("d3-geom");
      const elRxy = document.getElementById("d3-rxy");
      const elRxz = document.getElementById("d3-rxz");
      const elRyz = document.getElementById("d3-ryz");
      const elRxyz = document.getElementById("d3-rxyz");
      const n = 120;
      let baseZ, baseEx, baseEy;

      function reseed() {
        baseZ = new Array(n); baseEx = new Array(n); baseEy = new Array(n);
        for (let i = 0; i < n; i++) { baseZ[i] = gauss(); baseEx[i] = gauss(); baseEy[i] = gauss(); }
      }
      reseed();

      function computeData() {
        const sx = +sxSlider.value / 100;
        const sy = +syEl.value / 100;
        const dxy = +dxySlider.value / 100;
        sxVal.textContent = sx.toFixed(2);
        syVal.textContent = sy.toFixed(2);
        dxyVal.textContent = (dxy >= 0 ? "+" : "") + dxy.toFixed(2);
        const X = new Array(n), Y = new Array(n), Z = new Array(n);
        for (let i = 0; i < n; i++) {
          const z = baseZ[i];
          const fz = z * z - 1; // mean-zero nonlinear
          const x = sx * fz + 0.6 * baseEx[i];
          const y = sy * fz + 0.6 * baseEy[i] + dxy * x;
          X[i] = x; Y[i] = y; Z[i] = z;
        }
        return { X, Y, Z };
      }

      function arrow(svg, x1, y1, x2, y2, color, dashed, label, labelOffset) {
        const dx = x2 - x1, dy = y2 - y1;
        const len = Math.sqrt(dx * dx + dy * dy);
        if (len < 1) return;
        const ux = dx / len, uy = dy / len;
        const ah = 8;
        const hx = x2 - ux * ah;
        const hy = y2 - uy * ah;
        const px = -uy, py = ux;
        const cls = "vec-arrow " + color + (dashed ? " vec-residual" : "");
        svg.appendChild(el("line", { class: cls, x1, y1, x2: hx, y2: hy }));
        const pts = `${x2},${y2} ${hx + px * 3.5},${hy + py * 3.5} ${hx - px * 3.5},${hy - py * 3.5}`;
        svg.appendChild(el("polygon", { class: cls, points: pts, "stroke-dasharray": "none" }));
        if (label) {
          const lx = x2 + (labelOffset ? labelOffset[0] : ux * 10);
          const ly = y2 + (labelOffset ? labelOffset[1] : uy * 10);
          const colorVar = color === "vec-x" ? "var(--x-color)" : color === "vec-y" ? "var(--y-color)" : "var(--z-color)";
          svg.appendChild(el("text", {
            x: lx, y: ly, class: "axis-label",
            fill: colorVar, "font-weight": 600, "font-size": 12
          }, label));
        }
      }

      function redraw() {
        const { X, Y, Z } = computeData();
        const Atil = uCenter(distMatrix1D(X), n);
        const Btil = uCenter(distMatrix1D(Y), n);
        const Ctil = uCenter(distMatrix1D(Z), n);
        const nA = uNorm(Atil, n);
        const nB = uNorm(Btil, n);
        const nC = uNorm(Ctil, n);
        const rxy = nA * nB > 0 ? uInner(Atil, Btil, n) / (nA * nB) : 0;
        const rxz = nA * nC > 0 ? uInner(Atil, Ctil, n) / (nA * nC) : 0;
        const ryz = nB * nC > 0 ? uInner(Btil, Ctil, n) / (nB * nC) : 0;
        const denom = Math.sqrt(Math.max(0, 1 - rxz * rxz) * Math.max(0, 1 - ryz * ryz));
        const rxyz = denom === 0 ? 0 : (rxy - rxz * ryz) / denom;

        elRxy.textContent = fmtSigned(rxy);
        elRxz.textContent = fmtSigned(rxz);
        elRyz.textContent = fmtSigned(ryz);
        elRxyz.textContent = fmtSigned(rxyz);
        elRxyz.style.color = Math.abs(rxyz) > 0.05 ? "var(--neg)" : "var(--pos)";

        // ----- draw vectors -----
        clearSVG(svg);
        const w = 540, h = 320;
        const ox = 100, oy = h - 80;
        // scale vector lengths to fit
        const maxLen = Math.max(nA, nB, nC);
        const scale = 180 / Math.max(maxLen, 1e-9);
        const Llen = nC * scale;
        const Alen = nA * scale;
        const Blen = nB * scale;

        // angles relative to C-axis
        const thA = Math.acos(Math.max(-1, Math.min(1, rxz)));   // angle(A, C)
        const thB = Math.acos(Math.max(-1, Math.min(1, ryz)));   // angle(B, C)
        // pick sign on B so that the resulting angle(A,B) approximates arccos(rxy)
        const targetAB = Math.acos(Math.max(-1, Math.min(1, rxy)));
        // Option 1: A and B on same side of C  →  angle(A,B) = |thA - thB|
        // Option 2: A and B on opposite sides   →  angle(A,B) = thA + thB
        const sameSide = Math.abs(targetAB - Math.abs(thA - thB)) < Math.abs(targetAB - (thA + thB));
        const phiA = -thA;            // place A above x-axis
        const phiB = sameSide ? -thB : thB;

        // ----- C along x-axis -----
        const Cx = ox + Llen, Cy = oy;
        // C arrow
        arrow(svg, ox, oy, Cx, Cy, "vec-z", false, "C̃ (Z)", [10, 4]);

        // ----- A & B endpoints -----
        const Ax = ox + Alen * Math.cos(phiA);
        const Ay = oy + Alen * Math.sin(phiA);
        const Bx = ox + Blen * Math.cos(phiB);
        const By = oy + Blen * Math.sin(phiB);

        // alpha * C and beta * C (projection scalars)
        const alpha = nC > 0 ? uInner(Atil, Ctil, n) / uInner(Ctil, Ctil, n) : 0;
        const beta  = nC > 0 ? uInner(Btil, Ctil, n) / uInner(Ctil, Ctil, n) : 0;
        const aCx = ox + alpha * Llen, aCy = oy;
        const bCx = ox + beta * Llen,  bCy = oy;

        // alpha*C and beta*C colored segments along C (faint)
        svg.appendChild(el("line", {
          x1: ox, y1: oy + 7, x2: aCx, y2: oy + 7,
          stroke: "var(--x-color)", "stroke-width": 3, opacity: 0.45
        }));
        svg.appendChild(el("line", {
          x1: ox, y1: oy + 13, x2: bCx, y2: oy + 13,
          stroke: "var(--y-color)", "stroke-width": 3, opacity: 0.45
        }));
        // labels
        svg.appendChild(el("text", { x: aCx + 4, y: oy + 11, class: "axis-label", fill: "var(--x-color)" }, "α·C̃"));
        svg.appendChild(el("text", { x: bCx + 4, y: oy + 22, class: "axis-label", fill: "var(--y-color)" }, "β·C̃"));

        // A & B main arrows
        arrow(svg, ox, oy, Ax, Ay, "vec-x", false, "Ã (X)", [8, -4]);
        arrow(svg, ox, oy, Bx, By, "vec-y", false, "B̃ (Y)", [8, 14]);

        // residual = A - alpha*C, drawn from alpha*C tip to A tip
        arrow(svg, aCx, aCy, Ax, Ay, "vec-x", true);
        // residual = B - beta*C, drawn from beta*C tip to B tip
        arrow(svg, bCx, bCy, Bx, By, "vec-y", true);

        // arc for residual angle near origin: shift to common origin for clarity
        // also draw the two residual arrows from the common origin to make the angle visible
        const rxOrig = Ax - aCx, ryOrig = Ay - aCy;
        const sxOrig = Bx - bCx, syOrig = By - bCy;
        const ox2 = 400, oy2 = h / 2;
        // Length scale for "residual" panel
        const rA = Math.sqrt(rxOrig * rxOrig + ryOrig * ryOrig);
        const rB = Math.sqrt(sxOrig * sxOrig + syOrig * syOrig);
        const rMax = Math.max(rA, rB, 1);
        const rScale = 110 / rMax;
        const rAx = ox2 + rxOrig * rScale, rAy = oy2 + ryOrig * rScale;
        const rBx = ox2 + sxOrig * rScale, rBy = oy2 + syOrig * rScale;

        // dotted reference axis
        svg.appendChild(el("line", { x1: ox2 - 10, y1: oy2, x2: ox2 + 120, y2: oy2, stroke: "var(--border)", "stroke-width": 1, "stroke-dasharray": "2 3" }));

        // residual arrows from common origin
        arrow(svg, ox2, oy2, rAx, rAy, "vec-x", true, "PZ⊥(Ã)", [6, -4]);
        arrow(svg, ox2, oy2, rBx, rBy, "vec-y", true, "PZ⊥(B̃)", [6, 14]);
        // angle arc
        const angA = Math.atan2(rAy - oy2, rAx - ox2);
        const angB = Math.atan2(rBy - oy2, rBx - ox2);
        let a0 = angA, a1 = angB;
        // Always sweep from A to B the short way
        let da = a1 - a0;
        while (da > Math.PI) da -= 2 * Math.PI;
        while (da < -Math.PI) da += 2 * Math.PI;
        const arcR = 26;
        const lx0 = ox2 + arcR * Math.cos(a0), ly0 = oy2 + arcR * Math.sin(a0);
        const lx1 = ox2 + arcR * Math.cos(a0 + da), ly1 = oy2 + arcR * Math.sin(a0 + da);
        const sweep = da > 0 ? 1 : 0;
        const largeArc = Math.abs(da) > Math.PI ? 1 : 0;
        svg.appendChild(el("path", {
          d: `M ${lx0} ${ly0} A ${arcR} ${arcR} 0 ${largeArc} ${sweep} ${lx1} ${ly1}`,
          class: "arc", stroke: "var(--text-dim)"
        }));
        const midAng = a0 + da / 2;
        svg.appendChild(el("text", {
          x: ox2 + (arcR + 12) * Math.cos(midAng),
          y: oy2 + (arcR + 12) * Math.sin(midAng) + 4,
          class: "axis-label",
          "text-anchor": "middle",
          "font-weight": 600
        }, `θ = arccos R*(X,Y;Z)`));

        // section titles
        svg.appendChild(el("text", { x: ox, y: 20, class: "axis-label", "font-weight": 600, "text-anchor": "start" }, "Ã, B̃ and their projections onto C̃"));
        svg.appendChild(el("text", { x: ox2, y: 20, class: "axis-label", "font-weight": 600, "text-anchor": "middle" }, "Residuals"));

        // helper: R*(X,Y;Z) readout near arc
        svg.appendChild(el("text", {
          x: ox2, y: h - 14, class: "axis-label", "text-anchor": "middle"
        }, `cos θ = R*(X,Y;Z) = ${fmtSigned(rxyz)}`));
      }

      sxSlider.addEventListener("input", redraw);
      syEl.addEventListener("input", redraw);
      dxySlider.addEventListener("input", redraw);
      resampleBtn.addEventListener("click", () => { reseed(); redraw(); });
      redraw();
    }

    // ===================================================================
    // Section 4 — Dissimilarities + classical MDS
    // ===================================================================

    // Jacobi eigendecomposition for small symmetric matrices.
    function jacobiEig(M, n, maxSweeps = 100, tol = 1e-11) {
      const A = new Float64Array(M);
      const V = new Float64Array(n * n);
      for (let i = 0; i < n; i++) V[i * n + i] = 1;
      for (let sweep = 0; sweep < maxSweeps; sweep++) {
        let off = 0;
        for (let i = 0; i < n; i++)
          for (let j = i + 1; j < n; j++) off += A[i * n + j] * A[i * n + j];
        if (off < tol) break;
        for (let p = 0; p < n - 1; p++) {
          for (let q = p + 1; q < n; q++) {
            const apq = A[p * n + q];
            if (Math.abs(apq) < 1e-15) continue;
            const app = A[p * n + p], aqq = A[q * n + q];
            const theta = (aqq - app) / (2 * apq);
            const t = (theta >= 0 ? 1 : -1) / (Math.abs(theta) + Math.sqrt(theta * theta + 1));
            const c = 1 / Math.sqrt(t * t + 1);
            const s = t * c;
            A[p * n + p] = app - t * apq;
            A[q * n + q] = aqq + t * apq;
            A[p * n + q] = 0; A[q * n + p] = 0;
            for (let i = 0; i < n; i++) {
              if (i !== p && i !== q) {
                const aip = A[i * n + p], aiq = A[i * n + q];
                A[i * n + p] = c * aip - s * aiq; A[p * n + i] = A[i * n + p];
                A[i * n + q] = s * aip + c * aiq; A[q * n + i] = A[i * n + q];
              }
              const vip = V[i * n + p], viq = V[i * n + q];
              V[i * n + p] = c * vip - s * viq;
              V[i * n + q] = s * vip + c * viq;
            }
          }
        }
      }
      const eigvals = new Float64Array(n);
      for (let i = 0; i < n; i++) eigvals[i] = A[i * n + i];
      return { eigvals, eigvecs: V };
    }

    function cmdscaleFull(D, n, dim = 2) {
      const D2 = new Float64Array(n * n);
      for (let k = 0; k < n * n; k++) D2[k] = D[k] * D[k];
      const rowMean = new Float64Array(n);
      let grand = 0;
      for (let i = 0; i < n; i++) {
        let s = 0;
        for (let j = 0; j < n; j++) s += D2[i * n + j];
        rowMean[i] = s / n;
        grand += s;
      }
      grand /= n * n;
      const B = new Float64Array(n * n);
      for (let i = 0; i < n; i++)
        for (let j = 0; j < n; j++)
          B[i * n + j] = -0.5 * (D2[i * n + j] - rowMean[i] - rowMean[j] + grand);
      const { eigvals, eigvecs } = jacobiEig(B, n);
      const order = Array.from({ length: n }, (_, i) => i).sort((a, b) => eigvals[b] - eigvals[a]);
      const pts = new Array(n);
      for (let i = 0; i < n; i++) {
        const p = new Array(dim);
        for (let d = 0; d < dim; d++) {
          const lam = eigvals[order[d]];
          const sq = lam > 0 ? Math.sqrt(lam) : 0;
          p[d] = eigvecs[i * n + order[d]] * sq;
        }
        pts[i] = p;
      }
      // sorted eigenvalues (descending) for diagnostics
      const sortedEig = order.map(i => eigvals[i]);
      return { pts, eigvals: sortedEig };
    }

    function brayCurtis(counts) {
      const n = counts.length;
      const D = new Float64Array(n * n);
      for (let i = 0; i < n; i++) {
        for (let j = i + 1; j < n; j++) {
          let num = 0, den = 0;
          for (let k = 0; k < counts[i].length; k++) {
            num += Math.abs(counts[i][k] - counts[j][k]);
            den += counts[i][k] + counts[j][k];
          }
          const d = den === 0 ? 0 : num / den;
          D[i * n + j] = d; D[j * n + i] = d;
        }
      }
      return D;
    }

    function s4() {
      const resampleBtn = document.getElementById("d4-resample");
      const cSlider = document.getElementById("d4-c");
      const cVal = document.getElementById("d4-c-val");
      const svgBC = document.getElementById("d4-mat-bc");
      const svgUC = document.getElementById("d4-mat-uc");
      const svgMDS = document.getElementById("d4-mds");
      const elTri = document.getElementById("d4-tri");
      const elNorm = document.getElementById("d4-norm");
      const elRxy = document.getElementById("d4-rxy");
      const n = 8;
      let counts, env;

      function reseed() {
        // 8 sites, 4 species; counts driven by a hidden environmental gradient
        counts = []; env = [];
        for (let i = 0; i < n; i++) {
          const g = (i / (n - 1)) * 2 - 1 + 0.15 * gauss(); // environment
          env.push(g);
          const row = [];
          for (let k = 0; k < 4; k++) {
            const peak = -1 + 2 * k / 3;
            const v = 25 * Math.exp(-2 * (g - peak) * (g - peak)) + 1.5 * Math.abs(gauss());
            row.push(Math.max(0, v));
          }
          counts.push(row);
        }
      }
      reseed();

      function redraw() {
        const c = +cSlider.value / 100;
        cVal.textContent = (c >= 0 ? "+" : "") + c.toFixed(2);

        // Bray-Curtis on counts, plus Cailliez constant
        const Draw = brayCurtis(counts);
        const D = new Float64Array(n * n);
        for (let i = 0; i < n; i++)
          for (let j = 0; j < n; j++)
            D[i * n + j] = i === j ? 0 : Draw[i * n + j] + c;

        // (Min MDS eigenvalue is computed after cmdscale below.)

        // U-centered matrix
        const UC = uCenter(D, n);
        // matrix on env: dissimilarities = |env_i - env_j|
        const Denv = new Float64Array(n * n);
        for (let i = 0; i < n; i++)
          for (let j = 0; j < n; j++)
            Denv[i * n + j] = i === j ? 0 : Math.abs(env[i] - env[j]);
        const UCenv = uCenter(Denv, n);
        const inner = uInner(UC, UCenv, n);
        const nUC = uNorm(UC, n);
        const nUCenv = uNorm(UCenv, n);
        const rxy = nUC * nUCenv > 0 ? inner / (nUC * nUCenv) : 0;

        elNorm.textContent = fmt(nUC * nUC, 4);
        elRxy.textContent = fmtSigned(rxy);

        // Heatmaps. Use a shared scale across slider movements for D so transitions are visible.
        let maxD = 0;
        for (let k = 0; k < n * n; k++) if (D[k] > maxD) maxD = D[k];
        heatmap(svgBC, D, n, 220, 220, maxD || 1);
        // U-centered: scale to its own absmax so colours stay readable as c moves (they shouldn't)
        let maxUC = 0;
        for (let k = 0; k < n * n; k++) if (Math.abs(UC[k]) > maxUC) maxUC = Math.abs(UC[k]);
        heatmap(svgUC, UC, n, 220, 220, maxUC || 1);

        // Classical MDS recovery from D (with c)
        const { pts, eigvals: mdsEigs } = cmdscaleFull(D, n, 2);
        const minEig = mdsEigs[mdsEigs.length - 1];
        elTri.textContent = fmtSigned(minEig, 4);
        elTri.style.color = minEig < -1e-6 ? "var(--neg)" : "var(--pos)";
        // Scale to fit
        let xExt = autoExtent(pts.map(p => p[0]), 0.15);
        let yExt = autoExtent(pts.map(p => p[1]), 0.15);
        // Force square aspect
        const cx = (xExt[0] + xExt[1]) / 2, cy = (yExt[0] + yExt[1]) / 2;
        const half = Math.max(xExt[1] - cx, yExt[1] - cy, 1e-6);
        xExt = [cx - half, cx + half];
        yExt = [cy - half, cy + half];
        clearSVG(svgMDS);
        const w = 220, hh = 220, pad = 22;
        svgMDS.appendChild(el("line", { class: "axis", x1: pad, y1: hh - pad, x2: w - pad, y2: hh - pad }));
        svgMDS.appendChild(el("line", { class: "axis", x1: pad, y1: pad, x2: pad, y2: hh - pad }));
        const xs = v => pad + (v - xExt[0]) / (xExt[1] - xExt[0]) * (w - 2 * pad);
        const ys = v => hh - pad - (v - yExt[0]) / (yExt[1] - yExt[0]) * (hh - 2 * pad);
        for (let i = 0; i < n; i++) {
          const e = env[i];
          // color by environment
          const t = (e + 1) / 2;
          const cr = Math.round(220 - 200 * t);
          const cg = Math.round(80 + 100 * t);
          const cb = Math.round(60 + 180 * t);
          svgMDS.appendChild(el("circle", {
            cx: xs(pts[i][0]), cy: ys(pts[i][1]), r: 5,
            fill: `rgb(${cr},${cg},${cb})`, stroke: "white", "stroke-width": 1.5
          }));
          svgMDS.appendChild(el("text", {
            x: xs(pts[i][0]) + 7, y: ys(pts[i][1]) + 3, class: "axis-label"
          }, "site " + (i + 1)));
        }
      }

      cSlider.addEventListener("input", redraw);
      resampleBtn.addEventListener("click", () => { reseed(); redraw(); });
      redraw();
    }

    // ===================================================================
    // Section 2b — Bivariate normal closed form (Thm 7 of 2007 paper)
    // ===================================================================
    function bvnRSquared(rho) {
      const r = Math.abs(rho);
      const num = r * Math.asin(r) + Math.sqrt(1 - r * r) - r * Math.asin(r / 2) - Math.sqrt(4 - r * r) + 1;
      const denom = 1 + Math.PI / 3 - Math.sqrt(3);
      return num / denom;
    }
    function sbvn() {
      const rhoSlider = document.getElementById("dbvn-rho");
      const rhoVal = document.getElementById("dbvn-rho-val");
      const resampleBtn = document.getElementById("dbvn-resample");
      const svgScatter = document.getElementById("dbvn-scatter");
      const svgCurve = document.getElementById("dbvn-curve");
      const elR = document.getElementById("dbvn-r");
      const elRclosed = document.getElementById("dbvn-R");
      const elDcor = document.getElementById("dbvn-dcor");
      const elRatio = document.getElementById("dbvn-ratio");
      const n = 400;
      let baseU, baseV;
      function reseed() {
        baseU = new Array(n); baseV = new Array(n);
        for (let i = 0; i < n; i++) { baseU[i] = gauss(); baseV[i] = gauss(); }
      }
      reseed();
      function drawCurve(rho) {
        clearSVG(svgCurve);
        const w = 320, h = 240, pad = { l: 36, r: 14, t: 12, b: 32 };
        const xs = v => pad.l + (v + 1) / 2 * (w - pad.l - pad.r);
        const ys = v => h - pad.b - v * (h - pad.t - pad.b);
        // axes
        svgCurve.appendChild(el("line", { class: "axis", x1: pad.l, y1: h - pad.b, x2: w - pad.r, y2: h - pad.b }));
        svgCurve.appendChild(el("line", { class: "axis", x1: pad.l, y1: pad.t, x2: pad.l, y2: h - pad.b }));
        // gridlines + ticks
        for (let v = -1; v <= 1.0001; v += 0.5) {
          const x = xs(v);
          svgCurve.appendChild(el("line", { class: "grid-line", x1: x, y1: pad.t, x2: x, y2: h - pad.b }));
          svgCurve.appendChild(el("text", { x, y: h - pad.b + 14, class: "axis-label", "text-anchor": "middle" }, v.toFixed(1)));
        }
        for (let v = 0; v <= 1.0001; v += 0.25) {
          const y = ys(v);
          svgCurve.appendChild(el("line", { class: "grid-line", x1: pad.l, y1: y, x2: w - pad.r, y2: y }));
          svgCurve.appendChild(el("text", { x: pad.l - 4, y: y + 3, class: "axis-label", "text-anchor": "end" }, v.toFixed(2)));
        }
        svgCurve.appendChild(el("text", { x: (pad.l + w - pad.r) / 2, y: h - 4, class: "axis-label", "text-anchor": "middle" }, "ρ"));
        // curves
        const N = 80;
        let pathRho = "", pathR = "";
        for (let i = 0; i <= N; i++) {
          const r = -1 + 2 * i / N;
          const x = xs(r);
          pathRho += (i === 0 ? "M" : "L") + x + "," + ys(r * r) + " ";
          pathR += (i === 0 ? "M" : "L") + x + "," + ys(bvnRSquared(r)) + " ";
        }
        svgCurve.appendChild(el("path", { d: pathRho, fill: "none", stroke: "var(--text-dim)", "stroke-width": 1.5, "stroke-dasharray": "4 3" }));
        svgCurve.appendChild(el("path", { d: pathR, fill: "none", stroke: "var(--accent)", "stroke-width": 1.8 }));
        // labels for curves
        svgCurve.appendChild(el("text", { x: w - pad.r - 4, y: ys(1) + 14, class: "axis-label", "text-anchor": "end", fill: "var(--text-dim)" }, "ρ²"));
        svgCurve.appendChild(el("text", { x: w - pad.r - 4, y: ys(bvnRSquared(0.9)) - 4, class: "axis-label", "text-anchor": "end", fill: "var(--accent)", "font-weight": 600 }, "R²(ρ)"));
        // current ρ marker
        const r2 = bvnRSquared(rho);
        svgCurve.appendChild(el("line", { x1: xs(rho), y1: pad.t, x2: xs(rho), y2: h - pad.b, stroke: "var(--neg)", "stroke-width": 1, "stroke-dasharray": "2 2" }));
        svgCurve.appendChild(el("circle", { cx: xs(rho), cy: ys(r2), r: 4, fill: "var(--neg)" }));
      }
      function redraw() {
        const rho = +rhoSlider.value / 100;
        rhoVal.textContent = (rho >= 0 ? "+" : "") + rho.toFixed(2);
        const X = new Array(n), Y = new Array(n);
        const a = Math.sqrt(Math.max(0, 1 - rho * rho));
        for (let i = 0; i < n; i++) {
          X[i] = baseU[i];
          Y[i] = rho * baseU[i] + a * baseV[i];
        }
        scatter(svgScatter, X, Y, 240, 240, { xExt: [-3.2, 3.2], yExt: [-3.2, 3.2] });
        const rSample = pearson(X, Y);
        const dc = dCor(X, Y);
        const Rclosed = Math.sqrt(Math.max(0, bvnRSquared(rho)));
        elR.textContent = fmtSigned(rSample);
        elRclosed.textContent = fmt(Rclosed);
        elDcor.textContent = fmt(dc);
        elRatio.textContent = Math.abs(rho) > 0.01 ? fmt(Rclosed / Math.abs(rho)) : "—";
        drawCurve(rho);
      }
      rhoSlider.addEventListener("input", redraw);
      resampleBtn.addEventListener("click", () => { reseed(); redraw(); });
      redraw();
    }

    // ===================================================================
    // Section 3 — Permutation test
    // ===================================================================
    function sperm() {
      const shapeSel = document.getElementById("dperm-shape");
      const noiseSlider = document.getElementById("dperm-noise");
      const noiseVal = document.getElementById("dperm-noise-val");
      const runBtn = document.getElementById("dperm-run");
      const svgScatter = document.getElementById("dperm-scatter");
      const svgHist = document.getElementById("dperm-hist");
      const elObs = document.getElementById("dperm-obs");
      const elP = document.getElementById("dperm-p");
      const n = 60;
      let sample;
      let permTimer = 0;
      function regen() {
        const noise = +noiseSlider.value / 100;
        noiseVal.textContent = noise.toFixed(2);
        sample = genSample(shapeSel.value, n, noise);
        scatter(svgScatter, sample.X, sample.Y, 240, 240);
        elObs.textContent = fmt(dCovBiased(sample.X, sample.Y), 4);
        elP.textContent = "—";
        elP.style.color = "var(--text-dim)";
        clearSVG(svgHist);
      }
      function runPerm() {
        const observed = dCovBiased(sample.X, sample.Y);
        const nperm = 500;
        const draws = new Array(nperm);
        const Y = sample.Y.slice();
        for (let p = 0; p < nperm; p++) {
          for (let i = Y.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            const tmp = Y[i]; Y[i] = Y[j]; Y[j] = tmp;
          }
          draws[p] = dCovBiased(sample.X, Y);
        }
        let count = 0;
        for (const d of draws) if (d >= observed) count++;
        const pval = (count + 1) / (nperm + 1);
        elObs.textContent = fmt(observed, 4);
        elP.textContent = pval < 0.002 ? "< 0.002" : fmt(pval, 3);
        elP.style.color = pval < 0.05 ? "var(--pos)" : "var(--text-dim)";

        const w = 360, h = 240, pad = { l: 30, r: 14, t: 12, b: 28 };
        clearSVG(svgHist);
        const allVals = draws.concat([observed]);
        const ext = autoExtent(allVals, 0.05);
        const bins = 30;
        const counts = new Array(bins).fill(0);
        for (const d of draws) {
          let b = Math.floor((d - ext[0]) / (ext[1] - ext[0]) * bins);
          if (b < 0) b = 0; if (b >= bins) b = bins - 1;
          counts[b]++;
        }
        const maxC = Math.max(...counts);
        const obsBin = Math.floor((observed - ext[0]) / (ext[1] - ext[0]) * bins);
        for (let b = 0; b < bins; b++) {
          const x = pad.l + b * (w - pad.l - pad.r) / bins;
          const bw = (w - pad.l - pad.r) / bins - 1;
          const bh = counts[b] / maxC * (h - pad.t - pad.b);
          svgHist.appendChild(el("rect", {
            x, y: h - pad.b - bh, width: bw, height: bh,
            class: "hist-bar" + (b === obsBin ? " obs" : "")
          }));
        }
        svgHist.appendChild(el("line", { class: "axis", x1: pad.l, y1: h - pad.b, x2: w - pad.r, y2: h - pad.b }));
        svgHist.appendChild(el("line", { class: "axis", x1: pad.l, y1: pad.t, x2: pad.l, y2: h - pad.b }));
        const obsX = pad.l + (observed - ext[0]) / (ext[1] - ext[0]) * (w - pad.l - pad.r);
        svgHist.appendChild(el("line", { class: "observed-line", x1: obsX, y1: pad.t, x2: obsX, y2: h - pad.b }));
        svgHist.appendChild(el("text", { x: obsX + 4, y: pad.t + 10, class: "axis-label", fill: "var(--neg)" }, "observed"));
        svgHist.appendChild(el("text", { x: pad.l, y: h - 4, class: "axis-label" }, ext[0].toFixed(3)));
        svgHist.appendChild(el("text", { x: w - pad.r - 4, y: h - 4, class: "axis-label", "text-anchor": "end" }, ext[1].toFixed(3)));
      }
      function runPermNow() {
        clearTimeout(permTimer);
        runPerm();
      }
      function schedulePermRun() {
        clearTimeout(permTimer);
        regen();
        permTimer = window.setTimeout(runPerm, 200);
      }

      shapeSel.addEventListener("change", schedulePermRun);
      noiseSlider.addEventListener("input", schedulePermRun);
      runBtn.addEventListener("click", runPermNow);
      regen();
    }

    // ===================================================================
    // Section 7 — Network recovery (Pearson vs partial vs dCor)
    // ===================================================================
    function s7() {
      const varsN = 4, labels = ["A", "B", "C", "D"];
      const pos = { A: [40, 90], B: [90, 35], C: [90, 145], D: [140, 90] };
      const trueEdges = new Set(["A-B", "A-C", "B-D", "C-D"]);
      const candidatePairs = [];
      for (let i = 0; i < varsN; i++) for (let j = i + 1; j < varsN; j++) candidatePairs.push([labels[i], labels[j]]);
      const resampleBtn = document.getElementById("d7-resample");
      const nIn = document.getElementById("d7-n"), nV = document.getElementById("d7-n-val");
      const tauIn = document.getElementById("d7-tau"), tauV = document.getElementById("d7-tau-val");
      function gen(N) {
        const out = { A: [], B: [], C: [], D: [] };
        for (let i = 0; i < N; i++) {
          const A = gauss();
          const B = 0.9 * A + 0.45 * gauss();
          const C = -0.75 * A + 0.5 * gauss();
          const D = 0.8 * B - 0.6 * C + 0.45 * gauss();
          out.A.push(A); out.B.push(B); out.C.push(C); out.D.push(D);
        }
        return out;
      }
      function invertSymmetric(M) {
        // Gauss-Jordan inverse for small dense square matrix.
        const n = M.length;
        const A = M.map((row, i) => [...row, ...Array.from({ length: n }, (_, k) => (k === i ? 1 : 0))]);
        for (let i = 0; i < n; i++) {
          let p = i;
          for (let k = i + 1; k < n; k++) if (Math.abs(A[k][i]) > Math.abs(A[p][i])) p = k;
          [A[i], A[p]] = [A[p], A[i]];
          if (Math.abs(A[i][i]) < 1e-10) return null;
          const piv = A[i][i];
          for (let j = 0; j < 2 * n; j++) A[i][j] /= piv;
          for (let k = 0; k < n; k++) if (k !== i) {
            const f = A[k][i];
            for (let j = 0; j < 2 * n; j++) A[k][j] -= f * A[i][j];
          }
        }
        return A.map((row) => row.slice(n));
      }
      let selectedPair = null; // "A-B" etc
      function drawSkeleton(svgId, edges, color, scores) {
        const svg = document.getElementById(svgId);
        clearSVG(svg);
        for (const [a, b] of candidatePairs) {
          const key = `${a}-${b}`;
          const isEdge = edges.has(key);
          const inTrue = trueEdges.has(key);
          const isSelected = selectedPair === key;
          const stroke = isSelected ? "#d4690a" : (isEdge ? (inTrue ? "#2d7a3e" : "#b8412a") : (inTrue ? "rgba(45,122,62,0.25)" : "rgba(140,140,140,0.22)"));
          const width = isSelected ? 3.2 : (isEdge ? 2.4 : 1.2);
          const dash = isSelected ? "" : (isEdge ? "" : (inTrue ? "" : "3 4"));
          // Invisible thick line for hit-testing; visible thin line on top
          svg.appendChild(el("line", { x1: pos[a][0], y1: pos[a][1], x2: pos[b][0], y2: pos[b][1], stroke: "transparent", "stroke-width": 12, "data-pair": key, style: "cursor:pointer" }));
          svg.appendChild(el("line", { x1: pos[a][0], y1: pos[a][1], x2: pos[b][0], y2: pos[b][1], stroke, "stroke-width": width, "stroke-dasharray": dash, "pointer-events": "none" }));
        }
        for (const v of labels) {
          svg.appendChild(el("circle", { cx: pos[v][0], cy: pos[v][1], r: 14, fill: "#fff", stroke: color, "stroke-width": 2 }));
          svg.appendChild(el("text", { x: pos[v][0], y: pos[v][1] + 4, "text-anchor": "middle", "font-size": 12, fill: "#1f2733" }, v));
        }
        if (scores && !svg.dataset.bound) {
          svg.addEventListener("click", (event) => {
            const target = event.target;
            const key = target && target.getAttribute && target.getAttribute("data-pair");
            if (!key) return;
            selectedPair = selectedPair === key ? null : key;
            update();
          });
          svg.dataset.bound = "1";
        }
      }
      function recovery(edges) {
        let tp = 0, fp = 0;
        for (const e of edges) (trueEdges.has(e) ? tp++ : fp++);
        return { tp, fp, total: trueEdges.size };
      }
      function update() {
        const N = +nIn.value, tau = +tauIn.value;
        nV.textContent = String(N); tauV.textContent = tau.toFixed(2);
        const data = gen(N);
        const corr = Array.from({ length: varsN }, () => Array(varsN).fill(0));
        const dcorr = Array.from({ length: varsN }, () => Array(varsN).fill(0));
        for (let i = 0; i < varsN; i++) for (let j = i; j < varsN; j++) {
          const c = pearson(data[labels[i]], data[labels[j]]);
          corr[i][j] = corr[j][i] = c;
          const dc = i === j ? 1 : dCor(data[labels[i]], data[labels[j]]);
          dcorr[i][j] = dcorr[j][i] = dc;
        }
        const inv = invertSymmetric(corr);
        // Partial correlation: -inv[i][j] / sqrt(inv[i][i] inv[j][j])
        const partial = Array.from({ length: varsN }, () => Array(varsN).fill(0));
        if (inv) for (let i = 0; i < varsN; i++) for (let j = 0; j < varsN; j++) {
          partial[i][j] = i === j ? 1 : -inv[i][j] / Math.sqrt(Math.max(1e-12, inv[i][i] * inv[j][j]));
        }
        const peEdges = new Set(), paEdges = new Set(), dcEdges = new Set();
        for (let i = 0; i < varsN; i++) for (let j = i + 1; j < varsN; j++) {
          const key = `${labels[i]}-${labels[j]}`;
          if (Math.abs(corr[i][j]) >= tau) peEdges.add(key);
          if (Math.abs(partial[i][j]) >= tau) paEdges.add(key);
          if (dcorr[i][j] >= tau) dcEdges.add(key);
        }
        drawSkeleton("d7-true", trueEdges, "#1f4a8c", { corr, partial, dcorr });
        drawSkeleton("d7-pearson", peEdges, "#1f4a8c", { corr, partial, dcorr });
        drawSkeleton("d7-partial", paEdges, "#1f4a8c", { corr, partial, dcorr });
        drawSkeleton("d7-dcor", dcEdges, "#1f4a8c", { corr, partial, dcorr });
        const pr = recovery(peEdges), pa = recovery(paEdges), dr = recovery(dcEdges);
        function fmt(M, key) {
          if (!selectedPair) return `TP ${M.tp}/4 · FP ${M.fp}`;
          const [a, b] = selectedPair.split("-");
          const i = labels.indexOf(a), j = labels.indexOf(b);
          const v = key === "pearson" ? corr[i][j] : key === "partial" ? partial[i][j] : dcorr[i][j];
          return `${selectedPair}: ${v.toFixed(3)} (overall TP ${M.tp}/4 · FP ${M.fp})`;
        }
        document.getElementById("d7-pearson-stat").textContent = fmt(pr, "pearson");
        document.getElementById("d7-partial-stat").textContent = fmt(pa, "partial");
        document.getElementById("d7-dcor-stat").textContent = fmt(dr, "dcor");
      }
      resampleBtn.addEventListener("click", update);
      nIn.addEventListener("input", update);
      tauIn.addEventListener("input", update);
      update();
    }

    s1(); sbvn(); sperm(); s2(); s3(); s4(); s7();
  </script>
</ExplainerLayout>
