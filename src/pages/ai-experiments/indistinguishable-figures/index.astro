</style>

<script>
  const fig = document.getElementById("trace-figure");
  const btn = document.getElementById("trace-btn");
  const hint = document.getElementById("trace-hint");
  if (fig && btn && hint) {
    const a = fig.querySelector("#fig-a") as SVGPathElement | null;
    const b1 = fig.querySelector("#fig-b1") as SVGPathElement | null;
    const b2 = fig.querySelector("#fig-b2") as SVGPathElement | null;
    const NAVY = "#16324f", RUST = "#b3452c", TEAL = "#1f7a6d";
    let on = false;
    btn.addEventListener("click", () => {
      on = !on;
      btn.setAttribute("aria-pressed", String(on));
      btn.textContent = on ? "Reset" : "Trace the loops";
      if (a) a.style.stroke = on ? NAVY : "";
      if (b1) b1.style.stroke = on ? RUST : "";
      if (b2) b2.style.stroke = on ? TEAL : "";
      hint.textContent = on
        ? "A stays one color, one loop. B splits into two colors, two loops sharing the maze."
        : "A is one loop; B is two, wound through the same region.";
    });
  }
</script>
