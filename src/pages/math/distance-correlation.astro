---
import ExplainerLayout from "../../layouts/ExplainerLayout.astro";
import Hero from "../../components/explainer/Hero.astro";
import Aside from "../../components/explainer/Aside.astro";
import InteractivePanel from "../../components/explainer/InteractivePanel.astro";
import NextCards from "../../components/explainer/NextCards.astro";
---

<ExplainerLayout title="Distance Correlation — An Interactive Explainer" breadcrumb="Distance Correlation" section="probability-and-statistics">
  <style>
    :root {
      --bg: #f4f6f8;
      --surface: #ffffff;
      --surface-alt: #e4e8ed;
      --border: #bfc5cf;
      --text: #1e2530;
      --text-dim: #5a6577;
      --accent: #2563eb;
      --accent-soft: #dbeafe;
      --pos: #16a34a;
      --neg: #dc2626;
      --x-color: #2563eb;
      --y-color: #dc2626;
      --z-color: #64748b;
    }
    .page {
      max-width: 1120px;
      margin: 0 auto;
      padding: 32px 24px 80px;
    }
    .explainer { min-width: 0; }
    .byline { font-size: 13px; color: var(--text-dim); margin-bottom: 24px; }
    .byline a { color: var(--accent); text-decoration: none; }
