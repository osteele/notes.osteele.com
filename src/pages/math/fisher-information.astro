      <span><span class="swatch" style="background:#6b4592"></span>$A''(\eta) = \mathrm&#123;Var&#125;_\eta(T) = I(\eta)$</span>
      <span><span class="swatch" style="background:#d4690a"></span>tangent at selected $\eta$</span>
    </div>
</Fragment>
<Fragment slot="controls">
  <div class="control">
