<Fragment slot="legend">
  <div class="legend">
    <span><span class="swatch" style="background:#1f4a8c"></span>ridge (L2 / Gaussian prior)</span>
    <span><span class="swatch" style="background:#2d7a3e"></span>LASSO (L1 / Laplace prior)</span>
    <span><span class="swatch" style="background:#b8412a"></span>L0 (spike-and-slab)</span>
    <span><span class="swatch" style="background:#111827"></span>$\beta_&#123;\text&#123;OLS&#125;&#125;$ reference</span>
  </div>
</Fragment>
<Fragment slot="controls">
  <div class="ps-controls">
    <div class="ps-control-group">
      <strong>$\beta_&#123;\text&#123;OLS&#125;&#125;$:</strong>
      <input id="fig-shrink-bols" type="range" min="-3" max="3" step="0.02" value="1.6" />
      <span id="fig-shrink-bols-v">1.60</span>
    </div>
    <div class="ps-control-group">
      <strong>$\lambda$:</strong>
      <input id="fig-shrink-lambda" type="range" min="0.05" max="2.5" step="0.01" value="0.8" />
