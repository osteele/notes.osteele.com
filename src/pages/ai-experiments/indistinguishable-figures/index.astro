  }
  .prompt .who::before,
  blockquote.agent .who::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex: none;
  }

  /* human — hugs its text and sits on the right, like the app */
  .prompt {
    width: fit-content;
    max-width: 82%;
    margin-left: auto;
    font-size: 0.93rem;
    background: rgba(179, 69, 44, 0.1);
    border: 1px solid rgba(179, 69, 44, 0.26);
    border-top-right-radius: 5px;
  }
