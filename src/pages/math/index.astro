---
import MathIndexLayout from "../../layouts/MathIndexLayout.astro";
import { sections } from "../../lib/page-index";

const slug = (title) => title.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

---

<MathIndexLayout
  title="notes.osteele.com / math"
  description="Study notes on probability, information theory, random processes, Bayesian inference, and machine learning — each with an interactive figure or two."
>
  <style>
    :root {
      --bg: #fafbfc;
      --surface: #ffffff;
      --border: #e5e8ee;
      --border-strong: #cdd3dc;
      --text: #0f172a;
      --text-dim: #5a6577;
      --text-mute: #8892a3;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(900px 500px at 80% -10%, #eef2ff 0%, transparent 60%),
        radial-gradient(700px 400px at 0% 10%, #fdf2f8 0%, transparent 55%),
        var(--bg);
      color: var(--text);
      overflow-y: auto;
      min-height: 100vh;
    }

    .page-body {
      max-width: 1260px;
      margin: 0 auto;
      padding: 36px 24px 80px;
    }

    /* Two-column layout below the hero: sticky sidebar TOC + sections column.
       Collapses to a single column on narrower viewports, where the existing
       horizontal pill nav in the hero handles section jumping. */
    .page-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; }
    @media (min-width: 960px) {
      .page-grid { grid-template-columns: 200px minmax(0, 1fr); column-gap: 2.6rem; }
    }

    .sidebar-toc { display: none; }
    @media (min-width: 960px) {
      .sidebar-toc {
        display: block;
        position: sticky; top: 1.2rem; align-self: start;
        font-size: 0.82rem; line-height: 1.5;
        padding-top: 0.3rem;
        max-height: calc(100vh - 2rem);
        overflow: auto;
      }
      .sidebar-toc h4 {
        font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
        color: var(--text-mute); margin-bottom: 0.6rem; font-weight: 600;
      }
      .sidebar-toc ul { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--border); }
      .sidebar-toc li { margin: 0; }
      .sidebar-toc a {
        display: block; padding: 0.32rem 0.8rem;
        color: var(--text-dim); text-decoration: none;
        border-left: 2px solid transparent; margin-left: -2px;
        transition: color 0.15s, border-color 0.15s;
      }
      .sidebar-toc a:hover { color: var(--text); }
      .sidebar-toc a.active {
        color: var(--sidebar-accent, var(--text));
        border-left-color: var(--sidebar-accent, var(--text));
        font-weight: 600;
      }
      /* On wide viewports the hero's horizontal pill TOC is redundant. */
      .hero .toc { display: none; }
    }

    .hero {
      text-align: center;
      padding: 56px 0 28px;
    }
    .hero .eyebrow {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-mute);
      padding: 4px 10px;
      border: 1px solid var(--border-strong);
      border-radius: 999px;
      background: rgba(255,255,255,0.6);
      margin-bottom: 18px;
    }
    .hero h1 {
      font-size: 44px;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 14px;
      letter-spacing: -1.2px;
      line-height: 1.05;
      background: linear-gradient(135deg, #0f172a 0%, #2563eb 50%, #c026d3 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero .subtitle {
      font-size: 16px;
      color: var(--text-dim);
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.55;
    }
    .section-titles p.section-caveat {
      margin-top: 6px;
      font-size: 12px;
      line-height: 1.55;
      color: var(--text-dim);
      padding-left: 10px;
      border-left: 2px solid var(--caveat-accent, var(--border-strong));
    }

    .toc {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 22px;
    }
    .toc a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 500;
      color: var(--text-dim);
      text-decoration: none;
      padding: 5px 11px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.7);
      border-radius: 999px;
      transition: border-color 0.15s, color 0.15s, background 0.15s;
    }
    .toc a:hover {
      color: var(--text);
      border-color: var(--border-strong);
      background: #fff;
    }
    .toc a .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.65;
    }

    .section {
      margin-top: 44px;
    }
    .section-header {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding-bottom: 14px;
      margin-bottom: 18px;
      border-bottom: 1px solid var(--border);
      scroll-margin-top: 80px;
    }
    .section-glyph {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 9px;
      font-weight: 700;
      font-size: 16px;
      flex-shrink: 0;
    }
    .section-titles {
      flex: 1;
      min-width: 0;
    }
    .section-titles h2 {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.4px;
      margin-bottom: 3px;
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
    }
    .anchor-link {
      color: #93c5fd;
      text-decoration: none;
      font-weight: 600;
      font-size: 18px;
      opacity: 0;
      transition: opacity 0.15s, color 0.15s;
      line-height: 1;
    }
    .anchor-link:hover {
      color: #60a5fa;
    }
    .section-header:hover .anchor-link,
    .anchor-link:focus {
      opacity: 1;
    }
    .section-titles p {
      font-size: 13px;
      color: var(--text-dim);
      line-height: 1.5;
    }
    .section-titles p.section-credit {
      margin-top: 4px;
      font-size: 12px;
      font-style: italic;
      color: var(--text-mute);
      max-width: 64ch;
    }
    .section-count {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-mute);
      letter-spacing: 0.06em;
      padding-bottom: 4px;
      align-self: flex-end;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 14px;
    }
    .card {
      position: relative;
      display: flex;
      flex-direction: column;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 16px 14px;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s, transform 0.12s, box-shadow 0.15s;
      touch-action: manipulation;
      overflow: hidden;
    }
    .card::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 3px;
      background: var(--card-accent, var(--border-strong));
      opacity: 0.85;
      transition: width 0.18s ease;
    }
    .card:hover {
      border-color: var(--card-accent, var(--border-strong));
      transform: translateY(-2px);
      box-shadow: 0 6px 18px -8px rgba(15,23,42,0.18);
    }
    .card:hover::before {
      width: 5px;
    }
    .card .card-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
      letter-spacing: -0.2px;
    }
    .card .card-desc {
      font-size: 12.5px;
      color: var(--text-dim);
      line-height: 1.55;
      flex: 1;
    }
    .card .card-meta {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 10.5px;
      font-weight: 500;
      color: var(--text-mute);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-top: 12px;
    }
    .card .card-meta .pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 7px;
      border-radius: 999px;
      background: var(--card-tint, #eef2f7);
      color: var(--card-accent, var(--text-dim));
    }
    .card .card-meta .arrow {
      margin-left: auto;
      font-size: 13px;
      color: var(--card-accent, var(--text-mute));
      transition: transform 0.15s;
    }
    .card:hover .card-meta .arrow {
      transform: translate(2px, -2px);
    }

    .footer {
      text-align: center;
      padding: 56px 0 10px;
      font-size: 12px;
      color: var(--text-dim);
    }
    .footer a {
      color: #2563eb;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s;
    }
    .footer a:hover { border-color: currentColor; }

    @media (max-width: 720px) {
      .hero { padding: 36px 0 16px; }
      .hero h1 { font-size: 34px; }
      .hero .subtitle { font-size: 14px; }
      .section-header { gap: 10px; }
      .section-glyph { width: 30px; height: 30px; font-size: 14px; }
      .section-titles h2 { font-size: 18px; }
      .section-count { display: none; }
    }
    @media (max-width: 560px) {
      .page-body { padding: 24px 16px 56px; }
      .hero { text-align: left; }
      .hero h1 { font-size: 28px; }
      .toc { justify-content: flex-start; }
      .card-grid { grid-template-columns: 1fr; gap: 10px; }
      .card { padding: 14px; }
    }
  </style>

  <div class="page-body">

    <div class="hero">
      <div class="eyebrow">notes.osteele.com / math</div>
      <h1>Math Notes</h1>
      <div class="subtitle">
        Study notes on probability, information theory, random processes, Bayesian inference, and machine learning — each with at least one interactive figure.
      </div>
      <nav class="toc">
        {sections.map((s) => (
          <a href={`#${s.id ?? slug(s.title)}`} style={`color:${s.accent}`}>
            <span class="dot"></span>{s.title}
          </a>
        ))}
      </nav>
    </div>

    <div class="page-grid">
      <aside class="sidebar-toc" aria-label="Sections">
        <h4>Sections</h4>
        <ul>
          {sections.map((s) => {
            const sid = s.id ?? slug(s.title);
            return <li><a href={`#${sid}`} data-toc-target={sid} style={`--sidebar-accent:${s.accent}`}>{s.title}</a></li>;
          })}
        </ul>
      </aside>
      <div class="content">
    {sections.map((section) => (
      <div class="section">
        <div class="section-header" id={section.id ?? slug(section.title)}>
          <div
            class="section-glyph"
            style={`background:${section.tint};color:${section.accent};`}
          >
            {section.glyph}
          </div>
          <div class="section-titles">
            <h2>
              {section.title}
              <a class="anchor-link" href={`#${section.id ?? slug(section.title)}`} aria-label={`Link to ${section.title} section`}>#</a>
            </h2>
            <p>{section.description}</p>
            {section.attribution && <p class="section-credit">{section.attribution}</p>}
            {section.caveat && <p class="section-caveat" style={`--caveat-accent:${section.accent}`}>{section.caveat}</p>}
          </div>
          <div class="section-count">{section.items.length} {section.items.length === 1 ? "item" : "items"}</div>
        </div>
        <div class="card-grid">
          {section.items.map((item) => {
            const isExternal = item.href.startsWith("http");
            const host = isExternal ? new URL(item.href).hostname.replace(/^www\./, "") : null;
            const source = host?.includes("observablehq") ? "Observable" : host?.includes("github.io") ? "GitHub Pages" : host;
            // Badge precedence: explicit item.badge (e.g. "Paper review",
            // "Micro-site") > external host source. Internal pages with no
            // badge show no pill — "on this site" is the implicit default.
            const badgeLabel = item.badge ?? (isExternal ? source : null);
            return (
              <a
                class="card"
                href={item.href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener" : undefined}
                style={`--card-accent:${section.accent};--card-tint:${section.tint};`}
              >
                <div class="card-title">{item.title}</div>
                <div class="card-desc">{item.desc}</div>
                <div class="card-meta">
                  {badgeLabel && <span class="pill">{badgeLabel}</span>}
                  <span class="arrow">{isExternal ? "↗" : "→"}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ))}

      </div>
    </div>

    <div class="footer">
      Built by <a href="https://osteele.com">Oliver Steele</a>
    </div>

  </div>

  <script is:inline>
    (() => {
      const headers = document.querySelectorAll(".section-header[id]");
      const links = new Map();
      document.querySelectorAll(".sidebar-toc a[data-toc-target]").forEach((a) => {
        links.set(a.getAttribute("data-toc-target"), a);
      });
      if (!headers.length || !links.size) return;
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const link = links.get(e.target.id);
            if (!link) return;
            links.forEach((l) => l.classList.remove("active"));
            link.classList.add("active");
          }
        });
      }, { rootMargin: "-25% 0px -65% 0px" });
      headers.forEach((h) => obs.observe(h));
    })();
  </script>
</MathIndexLayout>
