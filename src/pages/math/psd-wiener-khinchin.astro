      <span><span class="swatch" style="background:#1f4a8c"></span>raw periodogram</span>
      <span><span class="swatch" style="background:#2d7a3e"></span>Welch estimate</span>
    </div>
</Fragment>
<Fragment slot="controls">
  <ControlRange id="fig4-welch-segments" label="segments" valueId="fig4-welch-segments-v" min="1" max="12" step="1" value="6" />
      <div class="control">
        <label>window</label>
        <select id="fig4-welch-window">
          <option value="rect">rectangular</option>
          <option value="hann" selected>Hann</option>
