<script is:inline>
(() => {
  const canvas = document.getElementById("fig-pushforward-cat");
  if (!canvas) return;

  function setup(c) {
    const ratio = window.devicePixelRatio || 1;
    const iw = +c.getAttribute("width"), ih = +c.getAttribute("height");
    c.style.width = "100%";
    c.style.height = `${c.getBoundingClientRect().width * ih / iw}px`;
    const r = c.getBoundingClientRect();
    c.width = r.width * ratio; c.height = r.height * ratio;
    const ctx = c.getContext("2d"); ctx.scale(ratio, ratio);
    return { ctx, w: r.width, h: r.height };
  }

  function drawNode(ctx, x, y, label, sub, fill) {
    ctx.font = "bold 16px -apple-system, system-ui, sans-serif";
    ctx.textAlign = "center"; ctx.textBaseline = "middle";
    const tw = ctx.measureText(label).width;
    const bw = Math.max(tw + 28, 72), bh = 36;
    ctx.fillStyle = fill || "#fff";
    ctx.strokeStyle = "#1f2733"; ctx.lineWidth = 1.4;
    ctx.beginPath();
    const rad = 6;
    ctx.moveTo(x - bw/2 + rad, y - bh/2);
    ctx.lineTo(x + bw/2 - rad, y - bh/2);
    ctx.quadraticCurveTo(x + bw/2, y - bh/2, x + bw/2, y - bh/2 + rad);
    ctx.lineTo(x + bw/2, y + bh/2 - rad);
    ctx.quadraticCurveTo(x + bw/2, y + bh/2, x + bw/2 - rad, y + bh/2);
    ctx.lineTo(x - bw/2 + rad, y + bh/2);
    ctx.quadraticCurveTo(x - bw/2, y + bh/2, x - bw/2, y + bh/2 - rad);
    ctx.lineTo(x - bw/2, y - bh/2 + rad);
    ctx.quadraticCurveTo(x - bw/2, y - bh/2, x - bw/2 + rad, y - bh/2);
    ctx.closePath(); ctx.fill(); ctx.stroke();
    ctx.fillStyle = "#0f172a";
    ctx.fillText(label, x, y);
    if (sub) {
      ctx.fillStyle = "#64748b";
      ctx.font = "11px -apple-system, system-ui, sans-serif";
      ctx.fillText(sub, x, y + bh/2 + 12);
    }
    return { halfW: bw / 2 };
  }

  function drawArrow(ctx, x1, y1, x2, y2, color, label, sublabel, halfWStart, halfWEnd) {
    ctx.strokeStyle = color; ctx.lineWidth = 2;
    const dx = x2 - x1, dy = y2 - y1, len = Math.hypot(dx, dy);
    const ux = dx / len, uy = dy / len;
    const sx = x1 + ux * (halfWStart + 6);
    const sy = y1 + uy * (halfWStart + 6);
    const ex = x2 - ux * (halfWEnd + 6);
    const ey = y2 - uy * (halfWEnd + 6);
    ctx.beginPath(); ctx.moveTo(sx, sy); ctx.lineTo(ex, ey); ctx.stroke();
    const ah = 9;
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(ex, ey);
    ctx.lineTo(ex - ux * ah - uy * ah * 0.5, ey - uy * ah + ux * ah * 0.5);
    ctx.lineTo(ex - ux * ah + uy * ah * 0.5, ey - uy * ah - ux * ah * 0.5);
    ctx.closePath(); ctx.fill();
    const mx = (sx + ex) / 2, my = (sy + ey) / 2;
    if (label) {
      ctx.fillStyle = color;
      ctx.font = "bold 13px -apple-system, system-ui, sans-serif";
      ctx.textAlign = "center"; ctx.textBaseline = "alphabetic";
      ctx.fillText(label, mx, my - 10);
    }
    if (sublabel) {
      ctx.fillStyle = "#64748b";
      ctx.font = "italic 11px -apple-system, system-ui, sans-serif";
      ctx.textAlign = "center"; ctx.textBaseline = "top";
      ctx.fillText(sublabel, mx, my + 8);
    }
  }

  function draw() {
    const { ctx, w, h } = setup(canvas);
    ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, w, h);

    const labelX = 92;
    const lX = labelX + (w - labelX) * 0.30;
    const rX = labelX + (w - labelX) * 0.78;
    const y1 = h * 0.18, y2 = h * 0.50, y3 = h * 0.82;

    ctx.fillStyle = "#334155";
    ctx.font = "italic 12px -apple-system, system-ui, sans-serif";
    ctx.textAlign = "right"; ctx.textBaseline = "middle";
    ctx.fillText("sample spaces", labelX - 6, y1);
    ctx.fillText("σ-algebras", labelX - 6, y2);
    ctx.fillText("measures", labelX - 6, y3);

    const srcFill = "#eef2f7", tgtFill = "#fde9e2";

    const n1L = drawNode(ctx, lX, y1, "Ω", "outcomes", srcFill);
    const n1R = drawNode(ctx, rX, y1, "E", "values", tgtFill);
    drawArrow(ctx, lX, y1, rX, y1, "#1f4a8c", "X", "ω ↦ X(ω)", n1L.halfW, n1R.halfW);

    const n2L = drawNode(ctx, lX, y2, "ℱ", "events on Ω", srcFill);
    const n2R = drawNode(ctx, rX, y2, "ℰ", "events on E", tgtFill);
    drawArrow(ctx, rX, y2, lX, y2, "#b8412a", "X⁻¹", "B ↦ X⁻¹(B)", n2R.halfW, n2L.halfW);

    const n3L = drawNode(ctx, lX, y3, "M(Ω)", "P lives here", srcFill);
    const n3R = drawNode(ctx, rX, y3, "M(E)", "X∗P lives here", tgtFill);
    drawArrow(ctx, lX, y3, rX, y3, "#1f4a8c", "X∗", "μ ↦ μ ∘ X⁻¹", n3L.halfW, n3R.halfW);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", draw);
  } else {
    draw();
  }
  window.addEventListener("resize", draw);
})();
</script>

