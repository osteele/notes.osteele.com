---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: string;
  image?: string;
  alt?: string;
  live?: boolean;
  canvasHeight?: number;
  preamble?: string;
  showLines?: string;
  animated?: boolean;
}

const { code, lang = "javascript", image, alt = "", live = false, canvasHeight = 200, preamble, showLines, animated = false } = Astro.props;

// Re-indent code based on brace nesting, since MDX strips leading whitespace
// from template literal content in JSX expressions.
function reindent(source: string, indent = "  "): string {
  const lines = source.trim().split("\n");
  let depth = 0;
  return lines.map((line) => {
    const trimmed = line.trim();
    if (trimmed.startsWith("}") || trimmed.startsWith("]") || trimmed.startsWith(")")) {
      depth = Math.max(0, depth - 1);
    }
    const result = trimmed.length > 0 ? indent.repeat(depth) + trimmed : "";
    if (trimmed.endsWith("{") || trimmed.endsWith("[") || trimmed.endsWith("(")) {
      depth++;
    }
    return result;
  }).join("\n");
}

// Extract visible lines from code based on showLines prop (e.g. "1-5,10-15").
// Gaps between ranges are rendered as "// …".
function extractShowLines(source: string, showLinesSpec: string | undefined): string {
  if (!showLinesSpec) return source;
  const lines = source.trim().split("\n");
  const ranges = showLinesSpec.split(",").map((r) => {
    const [start, end] = r.trim().split("-").map(Number);
    return { start, end: end ?? start };
  });
  const result: string[] = [];
  let lastEnd = 0;
  for (const { start, end } of ranges) {
    if (lastEnd > 0 && start > lastEnd + 1) {
      result.push("// …");
    }
    result.push(...lines.slice(start - 1, end));
    lastEnd = end;
  }
  return result.join("\n");
}

const displayCode = extractShowLines(code, showLines);
const formattedCode = reindent(displayCode);
const execCode = preamble ? preamble + "\n" + code : code;
const containerId = live ? `p5-container-${Math.random().toString(36).slice(2, 8)}` : null;
---

<div class="code-example">
  <Code code={formattedCode} lang={lang} theme="github-light" />
  {live && containerId && (
    <div class="canvas-preview">
      <div id={containerId} class="p5-canvas" data-sketch={execCode} data-code={code} data-preamble={preamble || ""} data-canvas-height={canvasHeight} data-animated={animated ? "true" : undefined}></div>
      <button class="p5-reset" aria-label="Reset values" style="display:none">↺</button>
      {animated && <button class="p5-play-pause" aria-label="Pause">⏸</button>}
    </div>
  )}
  {!live && image && (
    <div class="canvas-preview">
      <img src={image} alt={alt} />
    </div>
  )}
</div>

{live && (
  <script is:inline src="https://cdn.jsdelivr.net/npm/p5@1/lib/p5.min.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.p5-canvas').forEach(function(container) {
        if (container.dataset.initialized) return;
        container.dataset.initialized = 'true';

        var sketchCode = container.dataset.sketch;
        if (!sketchCode) return;

        var CANVAS_WIDTH = 500;
        var CANVAS_HEIGHT = parseInt(container.dataset.canvasHeight) || 200;
        var isAnimated = container.dataset.animated === 'true';
        var noLoopCall = isAnimated ? '' : ' p.noLoop();';
        var p5Instance = null;

        var MAX_LOOP_ITERATIONS = 10000;

        // Inject loop guards to prevent infinite loops when scrubbing values.
        // Declares a counter before each loop and checks it inside the body.
        function addLoopGuards(code) {
          var id = 0;
          return code.replace(/(for\s*\([^)]*\)\s*\{|while\s*\([^)]*\)\s*\{)/g, function(match) {
            var name = '__lc' + (id++);
            return 'var ' + name + '=0; ' + match + ' if(++' + name + '>' + MAX_LOOP_ITERATIONS + ') break;';
          });
        }

        function runSketch(code) {
          if (p5Instance) { p5Instance.remove(); }
          p5Instance = new p5(function(p) {
            var modified = addLoopGuards(code)
              .replace(/windowWidth/g, String(CANVAS_WIDTH))
              .replace(/windowHeight/g, String(CANVAS_HEIGHT));
            var fn = new Function('p', 'with (p) {\n' +
              modified + '\n' +
              'if (typeof setup === "function") {\n' +
              '  p.setup = function() { setup();' + noLoopCall + ' };\n' +
              '} else {\n' +
              '  p.setup = function() { createCanvas(' + CANVAS_WIDTH + ', ' + CANVAS_HEIGHT + '); background(100);' + noLoopCall + ' };\n' +
              '}\n' +
              'if (typeof draw === "function") {\n' +
              '  p.draw = draw;\n' +
              '}\n' +
              '}');
            fn(p);
          }, container);
          return p5Instance;
        }

        runSketch(sketchCode);

        // Play/pause for animated sketches
        if (isAnimated) {
          var playBtn = container.parentElement.querySelector('.p5-play-pause');
          if (playBtn) {
            var running = true;
            playBtn.addEventListener('click', function() {
              if (running) {
                p5Instance.noLoop();
                playBtn.textContent = '▶';
                playBtn.setAttribute('aria-label', 'Play');
              } else {
                p5Instance.loop();
                playBtn.textContent = '⏸';
                playBtn.setAttribute('aria-label', 'Pause');
              }
              running = !running;
            });
          }
        }

        // Scrubbable numbers
        var codeStr = container.dataset.code;
        var preambleStr = container.dataset.preamble || '';
        if (!codeStr) return;

        var codeBlock = container.closest('.code-example').querySelector('pre code');
        if (!codeBlock) return;

        // Parse number positions in original code
        var numRegex = /-?\d+(\.\d+)?/g;
        var positions = [];
        var match;
        while ((match = numRegex.exec(codeStr)) !== null) {
          positions.push({ start: match.index, end: match.index + match[0].length, original: match[0], current: match[0] });
        }

        // Find number spans in displayed code
        var spans = codeBlock.querySelectorAll('span');
        var numberSpans = [];
        for (var i = 0; i < spans.length; i++) {
          var span = spans[i];
          if (span.style.color === 'rgb(0, 92, 197)' || span.style.color === '#005CC5') {
            var text = span.textContent.trim();
            if (/^-?\d+(\.\d+)?$/.test(text)) {
              numberSpans.push(span);
            }
          }
        }

        // Map displayed spans to code positions sequentially
        var posIndex = 0;
        var mappings = [];
        for (var j = 0; j < numberSpans.length; j++) {
          var spanText = numberSpans[j].textContent.trim();
          while (posIndex < positions.length) {
            if (positions[posIndex].original === spanText) {
              var raw = numberSpans[j].textContent;
              var prefix = raw.substring(0, raw.length - raw.trimStart().length);
              mappings.push({ span: numberSpans[j], posIdx: posIndex, prefix: prefix });
              numberSpans[j].classList.add('scrubbable-number');
              numberSpans[j].dataset.original = spanText;
              posIndex++;
              break;
            }
            posIndex++;
          }
        }

        var resetBtn = container.parentElement.querySelector('.p5-reset');

        function rebuildAndRun() {
          var modified = codeStr;
          // Splice from end to preserve offsets
          for (var k = positions.length - 1; k >= 0; k--) {
            modified = modified.substring(0, positions[k].start) + positions[k].current + modified.substring(positions[k].end);
          }
          var execCode = preambleStr ? preambleStr + '\n' + modified : modified;
          runSketch(execCode);
          // Show/hide reset button
          var anyChanged = false;
          for (var k = 0; k < mappings.length; k++) {
            if (positions[mappings[k].posIdx].current !== positions[mappings[k].posIdx].original) {
              anyChanged = true;
              break;
            }
          }
          if (resetBtn) resetBtn.style.display = anyChanged ? '' : 'none';
        }

        // Drag state
        var dragging = null;

        function onMouseDown(e) {
          e.preventDefault();
          var span = e.currentTarget;
          var mapping = null;
          for (var k = 0; k < mappings.length; k++) {
            if (mappings[k].span === span) { mapping = mappings[k]; break; }
          }
          if (!mapping) return;
          var pos = positions[mapping.posIdx];
          var isFloat = pos.original.indexOf('.') !== -1;
          dragging = { span: span, mapping: mapping, startX: e.clientX, startVal: parseFloat(pos.current), isFloat: isFloat };
          document.body.style.cursor = 'ew-resize';
          document.body.style.userSelect = 'none';
        }

        document.addEventListener('mousemove', function(e) {
          if (!dragging) return;
          var delta = e.clientX - dragging.startX;
          var newVal;
          if (dragging.isFloat) {
            newVal = dragging.startVal + delta * 0.01;
            newVal = Math.round(newVal * 100) / 100;
          } else {
            newVal = Math.round(dragging.startVal + delta);
          }
          dragging.span.textContent = dragging.mapping.prefix + String(newVal);
          positions[dragging.mapping.posIdx].current = String(newVal);
          rebuildAndRun();
        });

        document.addEventListener('mouseup', function() {
          if (!dragging) return;
          dragging = null;
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
        });

        for (var m = 0; m < mappings.length; m++) {
          mappings[m].span.addEventListener('mousedown', onMouseDown);
        }

        // Reset button
        if (resetBtn) {
          resetBtn.addEventListener('click', function() {
            for (var k = 0; k < mappings.length; k++) {
              var pos = positions[mappings[k].posIdx];
              pos.current = pos.original;
              mappings[k].span.textContent = mappings[k].prefix + pos.original;
            }
            rebuildAndRun();
          });
        }
      });
    });
  </script>
)}
