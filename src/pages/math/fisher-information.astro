        <select id="fig3-logpartition-model">
          <option value="bernoulli">Bernoulli (η = log-odds)</option>
          <option value="poisson">Poisson (η = log λ)</option>
          <option value="exponential">Exponential (η = −λ)</option>
          <option value="normal-mean">Normal mean (η = μ, σ=1)</option>
